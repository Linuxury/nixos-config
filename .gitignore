# Nix build outputs
result
result-*

# Claude Code project memory (local dev tool — not part of the config)
.claude/

# nix-direnv
.direnv/

# Age-decrypted secrets (NEVER commit these — only .age files belong here)
secrets/*.conf
secrets/*.key
secrets/*.pem
secrets/*.txt
secrets/*.pass

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# Temporary files
*.tmp
*.bak

# hypridle.conf — generated symlink pointing to the host's profile (desktop/laptop)
# Managed by home.activation.hypridleConf in home.nix; source of truth is hypridle-{profile}.conf
dotfiles/hypr/hypridle.conf

# Matugen-generated color files (change on every wallpaper switch — not part of config)
dotfiles/hypr/colors.conf
dotfiles/hypr/colors-hyprlock.conf
dotfiles/hypr/waybar/colors.css
dotfiles/hypr/wofi/colors.css
dotfiles/hypr/swaync/colors.css

# DankMaterialShell — auto-generated by matugen/wallpaper pipeline
dotfiles/DankMaterialShell/dms-colors.json
dotfiles/DankMaterialShell/session.json
dotfiles/DankMaterialShell/settings.json
dotfiles/hypr/dms/colors.conf
