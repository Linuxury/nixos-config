# Nix build outputs
result
result-*

# Claude Code project memory (local dev tool — not part of the config)
.claude/

# nix-direnv
.direnv/

# Python bytecode cache
__pycache__/

# Age-decrypted secrets (NEVER commit these — only .age files belong here)
secrets/*.conf
secrets/*.key
secrets/*.pem
secrets/*.txt
secrets/*.pass

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# Temporary files
*.tmp
*.bak

# hypridle.conf — generated symlink pointing to the host's profile (desktop/laptop)
# Managed by home.activation.hypridleConf in home.nix; source of truth is hypridle-{profile}.conf
dotfiles/hypr/hypridle.conf

# Matugen-generated color files (change on every wallpaper switch — not part of config)
dotfiles/hypr/colors.conf
dotfiles/hypr/colors.lua
dotfiles/hypr/colors-hyprlock.conf
dotfiles/hypr/waybar/colors.css
dotfiles/hypr/wofi/colors.css
dotfiles/hypr/swaync/colors.css
dotfiles/hypr/hyprtoolkit.conf
dotfiles/hypr/noctalia.lua
dotfiles/nvim/lua/matugen.lua

# Umbriel — Noctalia's own theming output, regenerates on every wallpaper
# change; ~/.config/umbriel is a live symlink into this dir. Noctalia now
# writes Umbriel's real colors.border/colors.overview schema directly
# (schema mismatch fixed upstream 2026-09-05), no remap needed anymore.
dotfiles/umbriel/noctalia.toml
