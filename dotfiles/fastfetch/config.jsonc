{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // kitty-direct uses the kitty graphics protocol.
    // Source passed at runtime via --logo (random pick from ~/Pictures/Fastfetch/).
    // Image spec: auto-width × 950px height, tight crop, portrait orientation.
    "type": "kitty-direct",
    "width": 25,
    "height": 19,
    "padding": {
      "top": 0,
      "left": 3,
      "right": 3,
    },
  },
  "display": {
    "separator": "  ",
  },
  "modules": [

    // ── SYSTEM ────────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;79;154;208mSYSTEM\u001b[0m",
    },
    {
      "type": "os",
      "key": "󱄅 →",
      "keyColor": "#4f9ad0",
      "format": "{pretty-name}",
    },
    {
      "type": "command",
      "key": "󰌽 →",
      "keyColor": "#4f9ad0",
      "text": "kernel=$(uname -r); mesa=$(nix-store -q --references /run/opengl-driver 2>/dev/null | grep -oP 'mesa-[0-9.]+' | head -1 | cut -d- -f2); echo \"Linux ${kernel} · Mesa ${mesa}\"",
    },
    {
      "type": "command",
      "key": "󰏖 →",
      "keyColor": "#4f9ad0",
      "text": "nix=$(nix-store -q --requisites /nix/var/nix/profiles/system $HOME/.nix-profile 2>/dev/null | sort -u | wc -l); fp=$(flatpak list 2>/dev/null | wc -l); echo \"${nix} nix · ${fp} flatpak\"",
    },
    {
      "type": "processes",
      "key": "󰙰 →",
      "keyColor": "#4f9ad0",
      "format": "{} processes running",
    },
    {
      "type": "uptime",
      "key": "󰅐 →",
      "keyColor": "#4f9ad0",
    },
    "break",

    // ── DESKTOP ───────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;255;107;107mDESKTOP\u001b[0m",
    },
    {
      "type": "wm",
      "key": "󰖲 →",
      "keyColor": "#FF6B6B",
    },
    {
      "type": "lm",
      "key": "󰍹 →",
      "keyColor": "#FF6B6B",
    },
    {
      "type": "cursor",
      "key": "󰳽 →",
      "keyColor": "#FF6B6B",
    },
    {
      "type": "command",
      "key": "󰆍 →",
      "keyColor": "#FF6B6B",
      "text": "term=${TERM_PROGRAM:-${TERM}}; shell=$(basename \"$SHELL\"); echo \"${term} · ${shell}\"",
    },
    {
      "type": "command",
      "key": "󰛖 →",
      "keyColor": "#FF6B6B",
      "text": "font=$(grep '^font_family' ~/nixos-config/dotfiles/kitty/kitty.conf | awk '{$1=\"\"; print $0}' | xargs); size=$(grep '^font_size' ~/nixos-config/dotfiles/kitty/kitty.conf | awk '{print $2}'); echo \"${font} ${size}pt\"",
    },
    "break",

    // ── HARDWARE ──────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;255;225;163mHARDWARE\u001b[0m",
    },
    {
      "type": "command",
      "key": "󰢮 →",
      "keyColor": "#ffe1a3",
      "text": "vendor=$(cat /sys/class/dmi/id/board_vendor 2>/dev/null); board=$(cat /sys/class/dmi/id/board_name 2>/dev/null); bios=$(cat /sys/class/dmi/id/bios_version 2>/dev/null); echo \"${vendor} ${board} · BIOS ${bios}\"",
    },
    {
      "type": "cpu",
      "key": "󰻠 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "gpu",
      "key": "󰻑 →",
      "keyColor": "#ffe1a3",
      "detectionMethod": "vulkan",
    },
    {
      "type": "display",
      "key": "󰍹 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "memory",
      "key": "󰍛 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "swap",
      "key": "󰓡 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "disk",
      "key": "󰋊 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "command",
      "key": "󰈀 →",
      "keyColor": "#ffe1a3",
      "text": "iface=$(ip -4 route show default 2>/dev/null | awk '/dev/{print $5; exit}'); ip=$(ip -4 addr show \"$iface\" 2>/dev/null | awk '/inet /{print $2; exit}'); [ -n \"$ip\" ] && echo \"Ethernet ${ip}\" || echo \"Disconnected\"",
    },
    {
      "type": "wifi",
      "key": "󰤨 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "bluetooth",
      "key": "󰂯 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "battery",
      "key": "󰁹 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "poweradapter",
      "key": "󰚥 →",
      "keyColor": "#ffe1a3",
    },
    "break",


    // ── EXTRA ─────────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;203;166;247mEXTRA\u001b[0m",
    },
    {
      "type": "weather",
      "key": "󰖐 →",
      "keyColor": "#cba6f7",
    },
    {
      "type": "colors",
      "paddingLeft": 3,
      "symbol": "diamond",
    },

  ],
}
