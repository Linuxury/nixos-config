{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // kitty-direct uses the kitty graphics protocol.
    // Source passed at runtime via --logo (random pick from ~/Pictures/Fastfetch/).
    // Image spec: auto-width × 950px height, tight crop, portrait orientation.
    "type": "kitty-direct",
    "width": 25,
    "height": 19,
    "padding": {
      "top": 0,
      "left": 3,
      "right": 3,
    },
  },
  "display": {
    "separator": "  ",
  },
  "modules": [

    // ── SYSTEM ────────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;79;154;208mSYSTEM\u001b[0m",
    },
    {
      "type": "os",
      "key": "󱄅 →",
      "keyColor": "#4f9ad0",
      "format": "{pretty-name}",
    },
    {
      "type": "kernel",
      "key": "󰌽 →",
      "keyColor": "#4f9ad0",
    },
    {
      "type": "packages",
      "key": "󰏖 →",
      "keyColor": "#4f9ad0",
    },
    {
      "type": "processes",
      "key": "󰙰 →",
      "keyColor": "#4f9ad0",
      "format": "{} running",
    },
    {
      "type": "uptime",
      "key": "󰅐 →",
      "keyColor": "#4f9ad0",
    },
    "break",

    // ── DESKTOP ───────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;255;107;107mDESKTOP\u001b[0m",
    },
    {
      "type": "wm",
      "key": "󰖲 →",
      "keyColor": "#FF6B6B",
    },
    {
      "type": "wmtheme",
      "key": "󰔎 →",
      "keyColor": "#FF6B6B",
    },
    {
      "type": "cursor",
      "key": "󰳽 →",
      "keyColor": "#FF6B6B",
    },
    {
      "type": "terminal",
      "key": "󰆍 →",
      "keyColor": "#FF6B6B",
    },
    {
      "type": "terminalfont",
      "key": "󰛖 →",
      "keyColor": "#FF6B6B",
    },
    {
      "type": "shell",
      "key": "󱆃 →",
      "keyColor": "#FF6B6B",
    },
    {
      "type": "display",
      "key": "󰍹 →",
      "keyColor": "#FF6B6B",
    },
    "break",

    // ── HARDWARE ──────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;255;225;163mHARDWARE\u001b[0m",
    },
    {
      "type": "board",
      "key": "󰢮 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "cpu",
      "key": "󰻠 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "gpu",
      "key": "󰻑 →",
      "keyColor": "#ffe1a3",
      "detectionMethod": "vulkan",
    },
    {
      "type": "vulkan",
      "key": "󰖀 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "opengl",
      "key": "󰘚 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "memory",
      "key": "󰍛 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "swap",
      "key": "󰓡 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "physicalmemory",
      "key": "󰑁 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "disk",
      "key": "󰋊 →",
      "keyColor": "#ffe1a3",
    },
    "break",

    {
      "type": "bios",
      "key": "󰛫 →",
      "keyColor": "#4f9ad0",
    },
    {
      "type": "lm",
      "key": "󰍹 →",
      "keyColor": "#4f9ad0",
    },
    "break",

    // ── CONNECTIVITY ──────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;137;220;235mCONNECTIVITY\u001b[0m",
    },
    {
      "type": "localip",
      "key": "󰈀 →",
      "keyColor": "#89dceb",
      "showIpv4": true,
      "showIpv6": false,
    },
    {
      "type": "wifi",
      "key": "󰤨 →",
      "keyColor": "#89dceb",
    },
    {
      "type": "bluetooth",
      "key": "󰂯 →",
      "keyColor": "#89dceb",
    },
    {
      "type": "netio",
      "key": "󰛳 →",
      "keyColor": "#89dceb",
    },
    "break",

    // ── LAPTOP ────────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;255;179;71mLAPTOP\u001b[0m",
    },
    {
      "type": "battery",
      "key": "󰁹 →",
      "keyColor": "#ffb347",
    },
    {
      "type": "poweradapter",
      "key": "󰚥 →",
      "keyColor": "#ffb347",
    },
    "break",

    // ── EXTRA ─────────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;203;166;247mEXTRA\u001b[0m",
    },
    {
      "type": "weather",
      "key": "󰖐 →",
      "keyColor": "#cba6f7",
    },
    {
      "type": "colors",
      "paddingLeft": 3,
      "symbol": "diamond",
    },

  ],
}
