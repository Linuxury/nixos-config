{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // kitty-direct uses the kitty graphics protocol.
    // Source passed at runtime via --logo (random pick from ~/Pictures/Fastfetch/).
    // Image spec: square images (1:1). Cell size: 10×23px → ratio 2.3 → width=51 keeps them square.
    "type": "kitty-direct",
    "width": 51,
    "height": 22,
    "padding": {
      "top": 0,
      "left": 3,
      "right": 3,
    },
  },
  "display": {
    "separator": "  ",
  },
  "modules": [
    // ── SYSTEM ────────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;79;154;208mSYSTEM\u001b[0m",
    },
    {
      "type": "os",
      "key": "󱄅 →",
      "keyColor": "#4f9ad0",
      "format": "{pretty-name}",
    },
    {
      "type": "command",
      "key": "󰌽 →",
      "keyColor": "#4f9ad0",
      "text": "kernel=$(uname -r); mesa=$(nix-store -q --references /run/opengl-driver 2>/dev/null | grep -oP 'mesa-[0-9.]+' | head -1 | cut -d- -f2); echo \"Linux ${kernel} · Mesa ${mesa}\"",
    },
    {
      "type": "command",
      "key": "󰏖 →",
      "keyColor": "#4f9ad0",
      "text": "nix=$(nix-store -q --requisites /nix/var/nix/profiles/system $HOME/.nix-profile 2>/dev/null | sort -u | wc -l); fp=$(flatpak list 2>/dev/null | wc -l); echo \"${nix} nix · ${fp} flatpak\"",
    },
    {
      "type": "processes",
      "key": "󰙰 →",
      "keyColor": "#4f9ad0",
      "format": "{} processes running",
    },
    {
      "type": "uptime",
      "key": "󰅐 →",
      "keyColor": "#4f9ad0",
    },
    "break",

    // ── DESKTOP ───────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;255;107;107mDESKTOP\u001b[0m",
    },
    {
      "type": "command",
      "key": "󰖲 →",
      "keyColor": "#FF6B6B",
      "text": "de=\"\"; wm=\"\"; comm=\"\"; exe=\"\"; socket=$(ls /run/user/$(id -u)/wayland-* 2>/dev/null | grep -v lock | head -1); if [ -n \"$socket\" ]; then pid=$(ss -xlp 2>/dev/null | grep \"${socket##*/}\" | grep -oP 'pid=\\K[0-9]+' | head -1); exe=$(readlink /proc/$pid/exe 2>/dev/null); comm=$(basename \"$exe\" 2>/dev/null | sed 's/^\\.//; s/-wrapped$//'); [ -z \"$comm\" ] && comm=$(cat /proc/$pid/comm 2>/dev/null); fi; if [ -z \"$comm\" ]; then for c in kwin_x11 gnome-shell xfwm4 openbox i3 bspwm mutter; do wm_pid=$(pgrep -u $(id -u) \"$c\" 2>/dev/null | head -1); [ -n \"$wm_pid\" ] && exe=$(cat /proc/$wm_pid/cmdline 2>/dev/null | tr '\\0' '\\n' | head -1) && comm=\"$c\" && break; done; fi; case \"$comm\" in Hyprland) ver=$(hyprctl version 2>/dev/null | grep -oP 'v[\\d.]+' | head -1);; *) ver=$(echo \"$exe\" | grep -oP '(?<=-)[\\d]+\\.[\\d.]+(?=/bin/)');; esac; case \"$comm\" in cosmic-comp) dv=$(echo \"$exe\" | grep -oP '(?<=-)[\\d]+\\.[\\d.]+(?=/bin/)'); de=\"COSMIC${dv:+ $dv}\";; kwin_wayland|kwin_x11) de=\"KDE Plasma${ver:+ $ver}\";; gnome-shell) de=\"GNOME${ver:+ $ver}\";; esac; wm=\"${comm}${ver:+ $ver}\"; [ -n \"$(ls /run/user/$(id -u)/wayland-* 2>/dev/null)\" ] && session=\"Wayland\" || session=\"X11\"; out=\"\"; [ -n \"$de\" ] && out=\"${out:+$out · }$de\"; [ -n \"$wm\" ] && out=\"${out:+$out · }$wm\"; [ -n \"$session\" ] && out=\"${out:+$out · }$session\"; echo \"$out\"",
    },
    {
      "type": "command",
      "key": "󰍹 →",
      "keyColor": "#FF6B6B",
      "text": "mainpid=$(systemctl show display-manager.service -p MainPID --value 2>/dev/null); args=$(cat /proc/$mainpid/cmdline 2>/dev/null | tr '\\0' '\\n'); bin=$(echo \"$args\" | head -1); name=$(basename \"$bin\" | sed 's/^\\.//; s/-wrapped$//'); if [ \"$name\" = \"greetd\" ]; then config=$(echo \"$args\" | awk '/^--config$/{getline; print; exit}'); gb=$(grep -oP '/nix/store/\\S+' \"$config\" 2>/dev/null | grep '/bin/' | grep -v coreutils | tail -1 | sed \"s/'.*//\"); [ -n \"$gb\" ] && bin=\"$gb\" && name=$(basename \"$bin\" | sed 's/^\\.//; s/-wrapped$//; s/-start$//'); fi; ver=$(echo \"$bin\" | grep -oP '(?<=-)[\\d]+\\.[\\d.]+(?=/bin/)'); echo \"${name}${ver:+ $ver}\"",
    },
    {
      "type": "cursor",
      "key": "󰳽 →",
      "keyColor": "#FF6B6B",
    },
    {
      "type": "command",
      "key": "󰆍 →",
      "keyColor": "#FF6B6B",
      "text": "term=${TERM_PROGRAM:-${TERM}}; shell=$(basename \"$SHELL\"); echo \"${term} · ${shell}\"",
    },
    {
      "type": "command",
      "key": "󰛖 →",
      "keyColor": "#FF6B6B",
      "text": "font=$(grep '^font_family' ~/nixos-config/dotfiles/kitty/kitty.conf | awk '{$1=\"\"; print $0}' | xargs); size=$(grep '^font_size' ~/nixos-config/dotfiles/kitty/kitty.conf | awk '{print $2}'); echo \"${font} ${size}pt\"",
    },
    "break",

    // ── HARDWARE ──────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;255;225;163mHARDWARE\u001b[0m",
    },
    {
      "type": "command",
      "key": "󰢮 →",
      "keyColor": "#ffe1a3",
      "text": "vendor=$(cat /sys/class/dmi/id/board_vendor 2>/dev/null); board=$(cat /sys/class/dmi/id/board_name 2>/dev/null); bios=$(cat /sys/class/dmi/id/bios_version 2>/dev/null); echo \"${vendor} ${board} · BIOS ${bios}\"",
    },
    {
      "type": "cpu",
      "key": "󰻠 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "gpu",
      "key": "󰻑 →",
      "keyColor": "#ffe1a3",
      "detectionMethod": "vulkan",
    },
    {
      "type": "display",
      "key": "󰍹 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "memory",
      "key": "󰍛 →",
      "keyColor": "#ffe1a3",
      "format": "RAM {1} / {2} ({3})",
    },
    {
      "type": "swap",
      "key": "󰓡 →",
      "keyColor": "#ffe1a3",
      "format": "SWAP {1} / {2} ({3})",
    },
    {
      "type": "disk",
      "key": "󰋊 →",
      "keyColor": "#ffe1a3",
      "format": "NVMe {1} / {2} ({3}) - {9}",
      "folders": "/",
    },
    {
      "type": "disk",
      "key": "󰋊 →",
      "keyColor": "#ffe1a3",
      "format": "Games {1} / {2} ({3}) - {9}",
      "folders": "/mnt/Games",
    },
    {
      "type": "disk",
      "key": "󰋊 →",
      "keyColor": "#ffe1a3",
      "format": "Warehouse {1} / {2} ({3}) - {9}",
      "folders": "/mnt/Warehouse",
    },
    {
      "type": "disk",
      "key": "󰋊 →",
      "keyColor": "#ffe1a3",
      "format": "Media {1} / {2} ({3}) - {9}",
      "folders": "/data",
    },
    {
      "type": "command",
      "key": "󰈀 →",
      "keyColor": "#ffe1a3",
      "text": "iface=$(ip -4 route show default 2>/dev/null | awk '/dev/{print $5; exit}'); ip=$(ip -4 addr show \"$iface\" 2>/dev/null | awk '/inet /{print $2; exit}'); case \"$iface\" in wl*) ssid=$(nmcli -g GENERAL.CONNECTION dev show \"$iface\" 2>/dev/null); [ -n \"$ssid\" ] && label=\"WiFi · ${ssid}\" || label=WiFi;; en*|eth*) label=Ethernet;; *) label=${iface:-Network};; esac; [ -n \"$ip\" ] && echo \"${label} ${ip}\" || echo Disconnected",
    },
    {
      "type": "bluetooth",
      "key": "󰂯 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "battery",
      "key": "󰁹 →",
      "keyColor": "#ffe1a3",
    },
    {
      "type": "poweradapter",
      "key": "󰚥 →",
      "keyColor": "#ffe1a3",
    },
    "break",

    // ── WEATHER ───────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;203;166;247mWEATHER\u001b[0m",
    },
    {
      "type": "command",
      "key": "󰖐 →",
      "keyColor": "#cba6f7",
      "text": "curl -s 'wttr.in/?format=%c+%C+%t+(feels+%f)+%l' 2>/dev/null | sed 's/+\\([0-9]\\)/\\1/g'",
    },
    {
      "type": "colors",
      "paddingLeft": 3,
      "symbol": "diamond",
    },
  ],
}
