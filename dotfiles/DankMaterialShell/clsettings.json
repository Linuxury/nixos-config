{
  "$schema": "https://dank.moe/schemas/clsettings.json",
  "version": 1,
  "clipboard": {
    "enable": true,
    "ignore": [],
    "images": true,
    "max_history": 100,
    "persistent_history": true,
    "preview": true
  },
  "launcher": {
    "borders": 16,
    "margin": 8,
    "padding": 8,
    "roundness": 8
  },
  "magnifier": {
    "border_radius": 12,
    "crosshair": true,
    "cursor_size": 24,
    "outline": true,
    "outline_thickness": 2
  },
  "mouse": {
    "accel_profile": "flat",
    "natural_scroll": false,
    "tap_to_click": true
  },
  "overview": {
    "scale": 1.0,
    "smooth_scale": 0.2
  },
  "screenshot": {
    "copy_to_clipboard": true,
    "save_to_clipboard": true,
    "sound": true
  },
  "window": {
    "animate_structures": true,
    "contort": true,
    "double_click_interval": 350,
    "edge_gap": 10,
    "gap_fill": true,
    "gaps": true,
    "iconify": true,
    "osd": {
      "all_directional_keys": true,
      "workspace_indicator": true
    },
    "raise": true,
    "scale": 1.0,
    "snap": {
      "assist": true,
      "screenshare": true
    },
    "workspaces": {
      "create_on_activate": false,
      "delete_empty": false,
      "display_special": false,
      "smart": true
    }
  },
  "workspaces": {
    "auto_back_and_forth": true,
    "bind_workspaces": true,
    "ignore_empty": false,
    "mouse_warfare": true,
    "persistent_workspaces": {}
  }
}
