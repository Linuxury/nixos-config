# Ensure NixOS setuid wrappers always take priority — nix shells can displace them
typeset -U path
path=(/run/wrappers/bin $path)

# Default editor — Neovim for both terminal and "visual" contexts.
# Most tools check VISUAL first, then fall back to EDITOR.
export EDITOR=nvim
export VISUAL=nvim

# Canonical path to the nixos-config repo — used by nru and other tools
export NIXOS_CONFIG=$HOME/nixos-config

# System info on startup
fastfetch

# ---------------------------------------------------------------------------
# Completion styling
# ---------------------------------------------------------------------------
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ---------------------------------------------------------------------------
# NixOS management functions
#
# Config lives at ~/nixos-config (symlinked from /etc/nixos).
# The hostname is picked up automatically from the flake.
# Abbreviations for one-liner commands are defined declaratively in home.nix
# via programs.zsh.zsh-abbr.abbreviations — they expand inline before running.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# _fmt_nvd — formats nvd diff output into a clean aligned package-changes table.
#
# Collects all package data into arrays first, then renders in one pass so
# column widths can be computed from the actual data before the first row prints.
# Outputs the complete formatted block (header + table + footer + divider).
# Outputs nothing if no meaningful package changes are found.
# Handles both nvd long-form ("Added packages:") and short-form ([A]/[U]/[R]) output.
# ---------------------------------------------------------------------------
_fmt_nvd() {
  local section="" line
  # All loop variables declared here — zsh prints "var=value" if `local` is
  # re-run without assignment on an already-declared variable, so declaring
  # inside the while loop leaks values to the output.
  local pkg ver name old_v new_v rest old_vset new_vset
  local -a names=() old_vers=() new_vers=() actions=()
  local closure_old="" closure_new="" closure_added="" closure_removed="" closure_net="" closure_disk=""

  while IFS= read -r line; do
    [[ "$line" == '<<<'* || "$line" == '>>>'* ]] && continue
    [[ -z "${line// }" ]] && continue

    # Long-form section headers
    if [[ "$line" == 'Added packages:'   ]]; then section="added";   continue; fi
    if [[ "$line" == 'Removed packages:' ]]; then section="removed"; continue; fi
    if [[ "$line" == 'Version changes:'* ]]; then section="version"; continue; fi

    # Closure size line — extract all stats for the footer
    if [[ "$line" == 'Closure size:'* ]]; then
      closure_old=$(    printf '%s' "$line" | sed -E 's/Closure size: ([0-9]+).*/\1/')
      closure_new=$(    printf '%s' "$line" | sed -E 's/[^0-9]*[0-9]+ -> ([0-9]+).*/\1/')
      closure_added=$(  printf '%s' "$line" | sed -E 's/.*\(([0-9]+) paths added.*/\1/')
      closure_removed=$(printf '%s' "$line" | sed -E 's/.*, ([0-9]+) paths removed.*/\1/')
      closure_net=$(    printf '%s' "$line" | sed -E 's/.*delta ([+-]?[0-9]+).*/\1/')
      closure_disk=$(   printf '%s' "$line" | sed -E 's/.*disk usage ([^)]+)\).*/\1/')
      continue
    fi

    # Short-form prefix — update section from marker
    case "$line" in
      '[A.'*|'[A*'*) section="added"   ;;
      '[R.'*|'[R*'*) section="removed" ;;
      '[C.'*|'[C*'*|'[D.'*|'[D*'*|'[U.'*|'[U*'*) section="version" ;;
    esac

    case "$section" in
      added|removed)
        pkg=$(printf '%s' "$line" | sed -E 's/^\[[A-Z][.*]\]  #[0-9]+  //; s/^[a-z0-9]{32,}-//')
        [[ -z "$pkg" ]] && continue
        ver="${pkg##*  }"
        pkg="${pkg%%  *}"
        [[ "$pkg" == "source" || "$pkg" == "home-manager-"* || "$pkg" == "hm_"* || "$pkg" == "activation-script" ]] && continue
        ver=$(printf '%s' "$ver" | sed 's/, .*//')
        names+=("$pkg")
        actions+=("$section")
        if [[ "$section" == "added" ]]; then
          old_vers+=("-"); new_vers+=("$ver")
        else
          old_vers+=("$ver"); new_vers+=("-")
        fi
        ;;
      version)
        pkg=$(printf '%s' "$line" | sed -E 's/^\[[A-Z][.*]\]  //')
        [[ -z "$pkg" ]] && continue
        pkg=$(printf '%s' "$pkg" | sed -E 's/^#[0-9]+  +//')
        [[ -z "$pkg" ]] && continue
        [[ "$pkg" != *' -> '* ]] && continue
        name="${pkg%% *}"
        rest="${pkg#"$name"}"; rest="${rest#"${rest%%[! ]*}"}"
        old_v="${rest%% -> *}"; new_v="${rest##* -> }"
        # Strip multi-output noise (", 2.63.1-man") — keep only the first version token
        old_v=$(printf '%s' "$old_v" | sed 's/, .*//')
        new_v=$(printf '%s' "$new_v" | sed 's/, .*//')
        # Skip count-only closure changes (x3 → x2) — version itself didn't change
        old_vset=$(printf '%s' "$old_v" | sed -E 's/ x[0-9]+//g')
        new_vset=$(printf '%s' "$new_v" | sed -E 's/ x[0-9]+//g')
        [[ "$old_vset" == "$new_vset" ]] && continue
        old_v=$(printf '%s' "$old_v" | sed -E 's/ x[0-9]+//')
        new_v=$(printf '%s' "$new_v" | sed -E 's/ x[0-9]+//')
        names+=("$name"); old_vers+=("$old_v"); new_vers+=("$new_v"); actions+=("updated")
        ;;
    esac
  done

  local n_total=${#names[@]}
  [[ $n_total -eq 0 ]] && return

  # Count by action type
  local n_updated=0 n_added=0 n_removed=0 a
  for a in "${actions[@]}"; do
    case "$a" in updated) (( n_updated++ ));; added) (( n_added++ ));; removed) (( n_removed++ ));; esac
  done

  # Dynamic column widths — computed from actual data so the table is always tight
  local max_name=7 max_from=4 i  # floor = header label lengths ("Package", "From")
  for (( i=1; i<=n_total; i++ )); do
    [[ ${#names[$i]} -gt $max_name ]] && max_name=${#names[$i]}
    [[ ${#old_vers[$i]} -gt $max_from ]] && max_from=${#old_vers[$i]}
  done
  local col_name=$(( max_name + 2 )) col_from=$(( max_from + 4 ))

  # Section header: "─── Packages  ·  N updated  ·  +64.8 MiB ───..."
  local hparts="" j
  [[ $n_updated -gt 0 ]] && hparts="${n_updated} updated"
  [[ $n_added   -gt 0 ]] && hparts="${hparts:+${hparts}  ·  }${n_added} added"
  [[ $n_removed -gt 0 ]] && hparts="${hparts:+${hparts}  ·  }${n_removed} removed"
  [[ -n "$closure_disk" ]] && hparts="${hparts:+${hparts}  ·  }${closure_disk}"
  local htitle="─── Packages  ·  ${hparts} "
  local hfill="" hlen=$(( 60 - ${#htitle} ))
  for (( j=0; j<hlen; j++ )); do hfill="${hfill}─"; done

  # Table separator and closing divider
  local sep="" close="" sep_len=$(( col_name + col_from + 22 ))
  for (( j=0; j<sep_len; j++ )); do sep="${sep}─"; done
  for (( j=0; j<60; j++ )); do close="${close}─"; done

  # Render
  echo ""
  printf '%s%s\n' "$htitle" "$hfill"
  echo ""
  printf "  %-${col_name}s  %-${col_from}s  %s\n" "Package" "From" "To"
  printf "  %s\n" "$sep"
  for (( i=1; i<=n_total; i++ )); do
    printf "  %-${col_name}s  %-${col_from}s  %s\n" "${names[$i]}" "${old_vers[$i]}" "${new_vers[$i]}"
  done
  echo ""
  [[ -n "$closure_old" && -n "$closure_new" ]] && \
    printf "  Store paths: %s → %s  (%s new, %s removed, net %s)\n" \
      "$closure_old" "$closure_new" "$closure_added" "$closure_removed" "$closure_net"
  [[ -n "$closure_disk" ]] && printf "  Disk usage:  %s\n" "$closure_disk"
  echo ""
  printf '%s\n' "$close"
}

# ---------------------------------------------------------------------------
# _nix_fetch_filter — stdin filter used by _nixos_run.
#
# Accepts an optional spin_pid argument: the PID of a background spinner
# started by _nixos_run. The spinner is killed the moment awk takes over
# /dev/tty for a build or fetch progress bar.
#
# Four behaviors per line type:
#   - Build noise (agenix, store paths):       silently dropped
#   - "these N derivations will be built:":    starts a ⚙ build bar on /dev/tty
#   - "building /nix/store/...":               updates the build bar in-place
#   - "these N paths will be fetched":         starts a ↓ fetch bar on /dev/tty
#   - "copying path '...":                     updates the fetch bar in-place
#   - Everything else (activation, warnings):  passed through to stdout as-is
#
# Progress bar writes go to /dev/tty so \r can overwrite the same line
# without interfering with the normal pass-through output stream.
# ---------------------------------------------------------------------------
_nix_fetch_filter() {
  local spin_pid="${1:-0}"
  awk -v spin_pid="$spin_pid" '
  BEGIN { total=0; done=0; in_progress=0; bw=20; build_total=0; build_done=0; in_build=0 }

  # Kill the eval spinner and clear its line on /dev/tty before any output.
  # Called from every path that writes to stdout or /dev/tty so the spinner
  # text never bleeds into subsequent output.
  function killspinner() {
    if (spin_pid) {
      system("kill " spin_pid " 2>/dev/null")
      spin_pid = 0
      printf "\r\033[K" > "/dev/tty"
      fflush("/dev/tty")
    }
  }

  /^\[agenix\]/ || /^decrypting /                      { next }
  /^warning: Git tree .* is dirty/                      { next }
  /^Done\. The new configuration is \/nix\/store\//     { next }
  /^building the system configuration/                  { next }
  /^[[:space:]]+\/nix\/store\//                         { next }

  /^these [0-9]+ derivations will be built:/ {
    killspinner()
    if (in_progress) { printf "\n" > "/dev/tty"; fflush("/dev/tty"); in_progress=0 }
    match($0, /[0-9]+/)
    build_total = substr($0, RSTART, RLENGTH) + 0
    build_done = 0
    bar = sprintf("%*s", bw, ""); gsub(/ /, "░", bar)
    printf "\r  ⚙  0/%d  [%s]  0%%", build_total, bar > "/dev/tty"
    fflush("/dev/tty")
    in_build = 1
    next
  }

  /^building .*\/nix\/store\// {
    if (!in_build) { next }
    build_done++
    pct    = int(build_done * 100 / (build_total > 0 ? build_total : 1))
    filled = int(build_done * bw  / (build_total > 0 ? build_total : 1))
    bar = ""
    for (i=0; i<filled;    i++) bar = bar "█"
    for (i=0; i<bw-filled; i++) bar = bar "░"
    printf "\r  ⚙  %d/%d  [%s]  %d%%", build_done, build_total, bar, pct > "/dev/tty"
    fflush("/dev/tty")
    next
  }

  /^these [0-9]+ paths will be fetched/ {
    killspinner()
    if (in_build)    { printf "\n" > "/dev/tty"; fflush("/dev/tty"); in_build=0 }
    if (in_progress) { printf "\n" > "/dev/tty"; in_progress=0 }
    match($0, /[0-9]+/)
    total = substr($0, RSTART, RLENGTH) + 0
    done = 0
    bar = sprintf("%*s", bw, ""); gsub(/ /, "░", bar)
    printf "\r  ↓  0/%d  [%s]  0%%", total, bar > "/dev/tty"
    fflush("/dev/tty")
    in_progress = 1
    next
  }

  /^copying path / {
    if (!in_progress) { next }
    done++
    pct    = int(done * 100 / (total > 0 ? total : 1))
    filled = int(done * bw  / (total > 0 ? total : 1))
    bar = ""
    for (i=0; i<filled;    i++) bar = bar "█"
    for (i=0; i<bw-filled; i++) bar = bar "░"
    printf "\r  ↓  %d/%d  [%s]  %d%%", done, total, bar, pct > "/dev/tty"
    fflush("/dev/tty")
    next
  }

  # Unit lists ("restarting the following units: a, b, c") — render as a tree,
  # one unit per line, so long lists stay readable.
  /^(stopping|starting|restarting|reloading) the following .*units?: / ||
  /^the following new units were started: / {
    killspinner()
    if (in_build)    { printf "\n" > "/dev/tty"; fflush("/dev/tty"); in_build=0 }
    if (in_progress) { printf "\n" > "/dev/tty"; fflush("/dev/tty"); in_progress=0 }
    idx  = index($0, ": ")
    head = substr($0, 1, idx - 1)
    rest = substr($0, idx + 2)
    n = split(rest, units, ", ")
    print head ":"
    for (i = 1; i <= n; i++)
      printf "  %s %s\n", (i == n ? "└─" : "├─"), units[i]
    next
  }

  {
    killspinner()
    if (in_build)    { printf "\n" > "/dev/tty"; fflush("/dev/tty"); in_build=0 }
    if (in_progress) { printf "\n" > "/dev/tty"; fflush("/dev/tty"); in_progress=0 }
    print
  }

  END {
    if (in_build)    printf "\n" > "/dev/tty"
    if (in_progress) printf "\n" > "/dev/tty"
  }
  '
}

# ---------------------------------------------------------------------------
# _nixos_run — core rebuild helper used by nr / nru / nrb / nrt
#
# - Shows a clean build header with hostname
# - Holds a systemd sleep/idle inhibit lock for the full build duration
# - Tees all output (stdout + stderr) to a temp log alongside nom
# - Pipes through _nix_fetch_filter: suppresses noise, shows fetch progress
# - After the build: shows a package diff via nvd and calls nixos-log-rebuild
#   to write warnings and a timestamped entry to ~/Obsidian/09 🔄 Updates/
# ---------------------------------------------------------------------------
_nixos_run() {
  local tmplog exit_code old_system _spin_pid
  tmplog=$(mktemp /tmp/nixos-rebuild-XXXXXX.log)
  old_system=$(readlink -f /run/current-system 2>/dev/null)

  # Build header
  echo ""
  echo "══════════════════════════════════════════════════════════"
  printf "  ↻  Rebuilding  %s\n" "$(hostname)"
  echo "══════════════════════════════════════════════════════════"
  echo ""

  # Status line — visible during the silent build phase so the terminal
  # doesn't look frozen while nix evaluates and builds derivations.
  printf "  → Building...\n\n"

  # Spinner shown during the silent evaluation phase (nix evaluates the flake
  # with no output). &| starts it disowned so zsh never prints "[N] PID" or
  # "[N] Terminated" notifications. _nix_fetch_filter kills it the moment awk
  # first writes any output (build bar, fetch bar, or a pass-through line).
  {
    local -a _sp=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
    local _si=1
    while true; do
      printf "\r  %s  Evaluating…" "${_sp[$_si]}" > /dev/tty
      (( _si = _si % 10 + 1 ))
      sleep 0.1
    done
  } &|
  _spin_pid=$!

  # Run rebuild under a sleep/idle inhibit lock so the machine won't suspend
  # mid-build. systemd-inhibit wraps the command directly — no background job,
  # no "[N] PID" job notification. The lock releases automatically when the
  # command exits, regardless of exit code.
  #
  # _nix_fetch_filter receives the spinner PID so it can kill the spinner
  # before writing its own progress bars to /dev/tty.
  # The log (tee) captures raw output before the filter, so nothing is lost.
  systemd-inhibit --what=sleep:idle --who=nixos-rebuild \
    --why="NixOS rebuild in progress" \
    "$@" 2>&1 | tee "$tmplog" | _nix_fetch_filter "$_spin_pid"
  exit_code=$pipestatus[1]  # zsh: pipestatus[1] = exit code of "$@"

  # Kill spinner if still running (no build/fetch bars took over), then clear
  # its line so the next output starts on a clean line.
  kill "$_spin_pid" 2>/dev/null
  printf "\r\033[K" > /dev/tty

  # Package diff — only shown on successful switch with real package changes.
  # _fmt_nvd outputs the complete formatted block (header + table + footer +
  # divider), or nothing at all for config-only rebuilds with no package changes.
  if [[ $exit_code -eq 0 ]] && command -v nvd &>/dev/null; then
    local new_system fmt_output
    new_system=$(readlink -f /run/current-system 2>/dev/null)
    if [[ -n "$old_system" && "$old_system" != "$new_system" ]]; then
      fmt_output=$(nvd diff "$old_system" "$new_system" | _fmt_nvd)
      [[ -n "$fmt_output" ]] && printf '%s\n' "$fmt_output"
    fi
  fi

  # Write warnings + update log to vault (non-blocking, never fails the shell).
  # Output is captured silently; the generation number is extracted into
  # _NIXOS_LAST_GEN so callers (nru) can fold it into their success line.
  _NIXOS_LAST_GEN=""
  if command -v nixos-log-rebuild &>/dev/null; then
    local outcome="success" log_out
    [[ $exit_code -ne 0 ]] && outcome="failure"
    log_out=$(nixos-log-rebuild --outcome "$outcome" --log "$tmplog" 2>&1) || true
    _NIXOS_LAST_GEN=$(printf '%s' "$log_out" | grep -oE 'gen [0-9]+' | grep -oE '[0-9]+' | head -1)
  fi

  rm -f "$tmplog"
  return $exit_code
}

# Rebuild and switch to the current flake config.
nr() {
  _nixos_run sudo nixos-rebuild switch --no-link --flake "$NIXOS_CONFIG#$(hostname)"
}

# Test rebuild — activates now without touching the boot entry (safe for risky changes).
nrt() {
  _nixos_run sudo nixos-rebuild test --no-link --flake "$NIXOS_CONFIG#$(hostname)"
}

# ---------------------------------------------------------------------------
# _nru_prompt — displays a formatted (y/n) prompt, returns 0 for yes.
# Usage: _nru_prompt "✓" "message" && do_something
# ---------------------------------------------------------------------------
_nru_prompt() {
  local symbol="$1" msg="$2" reply
  # Read from /dev/tty explicitly — nom alters terminal state and a plain
  # 'read' after the pipeline may have no tty to read from.
  printf "\n  %s  %s  (Y/n)  " "$symbol" "$msg" > /dev/tty
  read -r reply < /dev/tty
  [[ -z "$reply" || "${reply:l}" == y ]]
}

# ---------------------------------------------------------------------------
# _nru_rebuild — runs the rebuild and shows the post-result interactive prompt.
# Kept separate from nru so that a retry skips the git pull / flake update.
# ---------------------------------------------------------------------------
_nru_rebuild() {
  _nixos_run sudo nixos-rebuild switch --no-link --flake "$NIXOS_CONFIG#$(hostname)"
  local exit_code=$?

  if [[ $exit_code -eq 1 ]]; then
    # Exit code 1 = build failure — worth retrying (e.g. network blip fetching a tarball)
    if _nru_prompt "✗" "Rebuild Failed :: Retry Rebuild?"; then
      _nru_rebuild
    fi
    return $exit_code
  elif [[ $exit_code -ne 0 ]]; then
    # Exit code 4 = unit activation warnings (e.g. fwupd-refresh timeout) — build succeeded,
    # retrying won't help. Continue to post-rebuild prompts.
    echo "⚠ Rebuild succeeded with unit warnings (exit $exit_code)"
  fi

  echo "✓ Rebuild successful${_NIXOS_LAST_GEN:+  (generation ${_NIXOS_LAST_GEN})}"

  # Push the updated flake.lock so other hosts get the same nixpkgs pin.
  # Git output is captured and hidden on success; shown in full on failure
  # so auth/divergence errors are never silently swallowed.
  if ! git -C "$NIXOS_CONFIG" diff --quiet flake.lock; then
    echo "→ Pushing updated flake.lock..."
    local git_out
    git -C "$NIXOS_CONFIG" add flake.lock
    if ! git_out=$(git -C "$NIXOS_CONFIG" commit -m "flake: update nixpkgs ($(date +%Y-%m-%d))" 2>&1); then
      printf '%s\n' "$git_out"
    fi
    if git_out=$(git -C "$NIXOS_CONFIG" push 2>&1); then
      printf "  ✓ pushed %s to %s\n" \
        "$(git -C "$NIXOS_CONFIG" rev-parse --short HEAD)" \
        "$(git -C "$NIXOS_CONFIG" branch --show-current)"
    else
      printf '%s\n' "$git_out"
      echo "  ✗ push failed — flake.lock is committed locally, push manually"
    fi
  fi

  # Check if a kernel update requires a reboot
  local current_kernel installed_kernel
  current_kernel=$(uname -r)
  installed_kernel=$(ls /run/current-system/kernel-modules/lib/modules/ 2>/dev/null | head -1)

  if [[ -n "$installed_kernel" && "$current_kernel" != "$installed_kernel" ]]; then
    echo "⚠ Kernel updated: $current_kernel → $installed_kernel"
    curl -s -o /dev/null --max-time 10 \
      -H "Title: Reboot Required — $(hostname)" \
      -H "Priority: high" \
      -H "Tags: warning,arrows_counterclockwise" \
      -d "Kernel updated (${installed_kernel}). Reboot when convenient." \
      "http://media-server:2586/nixos-updates" 2>/dev/null || true
    if _nru_prompt "⚠" "Rebuild Clean :: Requires Reboot :: Do it now?"; then
      sudo reboot
    fi
  else
    if _nru_prompt "✓" "Rebuild Clean :: Close Terminal?"; then
      exit 0
    fi
  fi
}

# Rebuild + pull latest nixpkgs before switching.
# Pulls latest git changes, bumps nixpkgs in flake.lock, rebuilds, commits
# the updated flake.lock, then prompts based on result:
#   clean        → offer to close terminal
#   needs reboot → offer to reboot now
#   failed       → offer to retry (without re-pulling or re-updating)
nru() {
  echo "→ Pulling latest changes from $NIXOS_CONFIG..."
  git -C "$NIXOS_CONFIG" restore flake.lock 2>/dev/null || true
  git -C "$NIXOS_CONFIG" pull || return 1
  echo "→ Updating nixpkgs..."
  # Condense the verbose lock-file update block (full URLs + narHashes) into a
  # one-liner with dates and short revs. Raw output is shown if the update
  # fails or produces something unexpected.
  local upd_out upd_code
  upd_out=$(nix flake update nixpkgs --flake "$NIXOS_CONFIG" 2>&1)
  upd_code=$?
  if [[ $upd_code -ne 0 ]]; then
    printf '%s\n' "$upd_out"
  elif printf '%s' "$upd_out" | grep -q "Updated input 'nixpkgs'"; then
    printf '%s\n' "$upd_out" | awk '
      /github:nixos\/nixpkgs\/[0-9a-f]{40}/ {
        match($0, /nixpkgs\/[0-9a-f]{40}/); rev = substr($0, RSTART+8, 7)
        match($0, /\([0-9]{4}-[0-9]{2}-[0-9]{2}\)/); dt = substr($0, RSTART+1, 10)
        if (!seen) { old_rev=rev; old_dt=dt; seen=1 }
        else printf "  ↑ nixpkgs: %s (%s) → %s (%s)\n", old_dt, old_rev, dt, rev
      }'
  else
    echo "  ✓ nixpkgs already up to date"
  fi
  _nru_rebuild
}

# NixOS aliases — available to all users on all hosts
alias nrr='sudo nixos-rebuild switch --rollback'
alias ngc='sudo nix-collect-garbage --delete-older-than 30d'
alias ngens='sudo nix-env --list-generations --profile /nix/var/nix/profiles/system'

# ---------------------------------------------------------------------------
# OpenCode — runs with OpenRouter API (key from agenix)
# ---------------------------------------------------------------------------
opencode() {
  ANTHROPIC_API_KEY="$(cat /run/agenix/openrouter-api-key 2>/dev/null)" \
  ANTHROPIC_BASE_URL="https://openrouter.ai/api" \
  command opencode "$@"
}

# ---------------------------------------------------------------------------
# Local environment variables — loaded from ~/.env.local if it exists
# Use this for API keys and secrets not tracked in git
# Example: ANTHROPIC_API_KEY=sk-ant-...
# ---------------------------------------------------------------------------
[[ -f "$HOME/.env.local" ]] && source "$HOME/.env.local"
