# ---------------------------------------------------------------------------
# _fmt_nvd — formats nvd diff output into a clean aligned package-changes table.
#
# Collects all package data into arrays first, then renders in one pass so
# column widths can be computed from the actual data before the first row prints.
# Outputs the complete formatted block (header + table + footer + divider).
# Outputs nothing if no meaningful package changes are found.
# Handles both nvd long-form ("Added packages:") and short-form ([A]/[U]/[R]) output.
# ---------------------------------------------------------------------------
_fmt_nvd() {
  local section="" line
  # All loop variables declared here — zsh prints "var=value" if `local` is
  # re-run without assignment on an already-declared variable, so declaring
  # inside the while loop leaks values to the output.
  local pkg ver name old_v new_v rest old_vset new_vset
  local -a names=() old_vers=() new_vers=() actions=()
  local closure_old="" closure_new="" closure_added="" closure_removed="" closure_net="" closure_disk=""

  while IFS= read -r line; do
    [[ "$line" == '<<<'* || "$line" == '>>>'* ]] && continue
    [[ -z "${line// }" ]] && continue

    # Long-form section headers
    if [[ "$line" == 'Added packages:'   ]]; then section="added";   continue; fi
    if [[ "$line" == 'Removed packages:' ]]; then section="removed"; continue; fi
    if [[ "$line" == 'Version changes:'* ]]; then section="version"; continue; fi

    # Closure size line — extract all stats for the footer
    if [[ "$line" == 'Closure size:'* ]]; then
      closure_old=$(    printf '%s' "$line" | sed -E 's/Closure size: ([0-9]+).*/\1/')
      closure_new=$(    printf '%s' "$line" | sed -E 's/[^0-9]*[0-9]+ -> ([0-9]+).*/\1/')
      closure_added=$(  printf '%s' "$line" | sed -E 's/.*\(([0-9]+) paths added.*/\1/')
      closure_removed=$(printf '%s' "$line" | sed -E 's/.*, ([0-9]+) paths removed.*/\1/')
      closure_net=$(    printf '%s' "$line" | sed -E 's/.*delta ([+-]?[0-9]+).*/\1/')
      closure_disk=$(   printf '%s' "$line" | sed -E 's/.*disk usage ([^)]+)\).*/\1/')
      continue
    fi

    # Short-form prefix — update section from marker
    case "$line" in
      '[A.'*|'[A*'*|'[A+'*|'[A-'*) section="added"   ;;
      '[R.'*|'[R*'*|'[R+'*|'[R-'*) section="removed" ;;
      '[C.'*|'[C*'*|'[C+'*|'[C-'*|'[D.'*|'[D*'*|'[D+'*|'[D-'*|'[U.'*|'[U*'*|'[U+'*|'[U-'*) section="version" ;;
    esac

    case "$section" in
      added|removed)
        pkg=$(printf '%s' "$line" | sed -E 's/^\[[A-Z].\]  #[0-9]+  //; s/^[a-z0-9]{32,}-//')
        [[ -z "$pkg" ]] && continue
        ver="${pkg##*  }"
        pkg="${pkg%%  *}"
        [[ "$pkg" == "source" || "$pkg" == "home-manager-"* || "$pkg" == "hm_"* || "$pkg" == "activation-script" ]] && continue
        ver=$(printf '%s' "$ver" | sed 's/, .*//')
        names+=("$pkg")
        actions+=("$section")
        if [[ "$section" == "added" ]]; then
          old_vers+=("-"); new_vers+=("$ver")
        else
          old_vers+=("$ver"); new_vers+=("-")
        fi
        ;;
      version)
        pkg=$(printf '%s' "$line" | sed -E 's/^\[[A-Z][.*]\]  //')
        [[ -z "$pkg" ]] && continue
        pkg=$(printf '%s' "$pkg" | sed -E 's/^#[0-9]+  +//')
        [[ -z "$pkg" ]] && continue
        [[ "$pkg" != *' -> '* ]] && continue
        name="${pkg%% *}"
        rest="${pkg#"$name"}"; rest="${rest#"${rest%%[! ]*}"}"
        old_v="${rest%% -> *}"; new_v="${rest##* -> }"
        # Strip multi-output noise (", 2.63.1-man") — keep only the first version token
        old_v=$(printf '%s' "$old_v" | sed 's/, .*//')
        new_v=$(printf '%s' "$new_v" | sed 's/, .*//')
        # Skip count-only closure changes (x3 → x2) — version itself didn't change
        old_vset=$(printf '%s' "$old_v" | sed -E 's/ x[0-9]+//g')
        new_vset=$(printf '%s' "$new_v" | sed -E 's/ x[0-9]+//g')
        [[ "$old_vset" == "$new_vset" ]] && continue
        old_v=$(printf '%s' "$old_v" | sed -E 's/ x[0-9]+//')
        new_v=$(printf '%s' "$new_v" | sed -E 's/ x[0-9]+//')
        names+=("$name"); old_vers+=("$old_v"); new_vers+=("$new_v"); actions+=("updated")
        ;;
    esac
  done

  local n_total=${#names[@]}
  [[ $n_total -eq 0 ]] && return

  # Count by action type
  local n_updated=0 n_added=0 n_removed=0 a
  for a in "${actions[@]}"; do
    case "$a" in updated) (( n_updated++ ));; added) (( n_added++ ));; removed) (( n_removed++ ));; esac
  done

  # Dynamic column widths — computed from actual data so the table is always tight
  local max_name=7 max_from=4 i  # floor = header label lengths ("Package", "From")
  for (( i=1; i<=n_total; i++ )); do
    [[ ${#names[$i]} -gt $max_name ]] && max_name=${#names[$i]}
    [[ ${#old_vers[$i]} -gt $max_from ]] && max_from=${#old_vers[$i]}
  done
  local col_name=$(( max_name + 2 )) col_from=$(( max_from + 4 ))

  # Section header: "─── Packages  ·  N updated  ·  +64.8 MiB ───..."
  local hparts="" j
  [[ $n_updated -gt 0 ]] && hparts="${n_updated} updated"
  [[ $n_added   -gt 0 ]] && hparts="${hparts:+${hparts}  ·  }${n_added} added"
  [[ $n_removed -gt 0 ]] && hparts="${hparts:+${hparts}  ·  }${n_removed} removed"
  [[ -n "$closure_disk" ]] && hparts="${hparts:+${hparts}  ·  }${closure_disk}"
  local htitle="─── Packages  ·  ${hparts} "
  local hfill="" hlen=$(( 58 - ${#htitle} ))
  for (( j=0; j<hlen; j++ )); do hfill="${hfill}─"; done

  # Table separator and closing divider
  local sep="" close="" sep_len=$(( col_name + col_from + 22 ))
  for (( j=0; j<sep_len; j++ )); do sep="${sep}─"; done
  for (( j=0; j<58; j++ )); do close="${close}─"; done

  # Render
  echo ""
  printf '%s%s\n' "$htitle" "$hfill"
  echo ""
  printf "  %-${col_name}s  %-${col_from}s  %s\n" "Package" "From" "To"
  printf "  %s\n" "$sep"
  for (( i=1; i<=n_total; i++ )); do
    printf "  %-${col_name}s  %-${col_from}s  %s\n" "${names[$i]}" "${old_vers[$i]}" "${new_vers[$i]}"
  done
  echo ""
  [[ -n "$closure_old" && -n "$closure_new" ]] && \
    printf "  Store paths: %s → %s  (%s new, %s removed, net %s)\n" \
      "$closure_old" "$closure_new" "$closure_added" "$closure_removed" "$closure_net"
  [[ -n "$closure_disk" ]] && printf "  Disk usage:  %s\n" "$closure_disk"
  echo ""
  printf '%s\n' "$close"
}

# ---------------------------------------------------------------------------
# _nix_fetch_filter — stdin filter used by _nixos_run.
#
# Accepts an optional spin_pid argument: the PID of a background spinner
# started by _nixos_run. The spinner is killed the moment awk takes over
# /dev/tty for a build or fetch progress bar.
#
# Four behaviors per line type:
#   - Build noise (agenix, store paths):       silently dropped
#   - "these N derivations will be built:":    starts a ⚙ build bar on /dev/tty
#   - "building /nix/store/...":               updates the build bar in-place
#   - "these N paths will be fetched":         starts a ↓ fetch bar on /dev/tty
#   - "copying path '...":                     updates the fetch bar in-place
#   - Everything else (activation, warnings):  passed through to stdout as-is
#
# Progress bar writes go to /dev/tty so \r can overwrite the same line
# without interfering with the normal pass-through output stream.
# ---------------------------------------------------------------------------
_nix_fetch_filter() {
  local spin_pid="${1:-0}"
  local animscript="${2:-}"
  local animpid="${3:-}"
  local statef="${4:-}"
  awk -v spin_pid="$spin_pid" -v animscript="$animscript" -v animpid="$animpid" -v statef="$statef" '
  BEGIN { total=0; done=0; in_progress=0; bw=20; build_total=0; build_done=0; in_build=0; build_label=""; fetch_label=""; n_stopped=0; n_restarted=0; n_reloaded=0; n_started=0; n_new=0 }

  function killspinner() {
    if (spin_pid) {
      system("kill " spin_pid " 2>/dev/null")
      spin_pid = 0
      printf "\r\033[K" > "/dev/tty"
      fflush("/dev/tty")
    }
  }

  function spawn_anim(    cmd) {
    if (animscript == "") return
    system("kill $(cat " animpid " 2>/dev/null) 2>/dev/null; true")
    system("sh " animscript " " statef " " animpid " &")
  }

  function kill_anim() {
    if (animpid == "") return
    system("kill $(cat " animpid " 2>/dev/null) 2>/dev/null; true")
  }

  # Close the build bar. Two-line zone: cursor is at end of secondary bar (line 2).
  # If items were cached (bar never reached 100%), rewrite line 1 as cached.
  # blank=1 adds an extra blank line after; blank=0 skips it.
  function close_build(blank,    bar, i, count_str) {
    if (!in_build) return
    kill_anim()
    bar = ""
    for (i = 0; i < bw; i++) bar = bar "■"
    if (build_done < build_total) {
      count_str = sprintf("%d/%d", build_total, build_total)
      printf "\r\033[1A  ⚒  %8s  [%s]  100%%  cached\033[K\r\n\r\033[K\n", count_str, bar > "/dev/tty"
    } else {
      printf "\r\033[K\n" > "/dev/tty"
    }
    if (blank) printf "\n" > "/dev/tty"
    fflush("/dev/tty")
    in_build = 0
    build_label = ""
  }

  # Buffer a unit into its action group with deduplication (insertion order preserved).
  function add_unit(action, unit) {
    if (action == "stopped")   { if (!stopped_seen[unit])   { stopped_seen[unit]=1;   stopped_ord[++n_stopped]=unit   } }
    if (action == "restarted") { if (!restarted_seen[unit]) { restarted_seen[unit]=1; restarted_ord[++n_restarted]=unit } }
    if (action == "reloaded")  { if (!reloaded_seen[unit])  { reloaded_seen[unit]=1;  reloaded_ord[++n_reloaded]=unit  } }
    if (action == "started")   { if (!started_seen[unit])   { started_seen[unit]=1;   started_ord[++n_started]=unit   } }
    if (action == "new")       { if (!new_seen[unit])       { new_seen[unit]=1;       new_ord[++n_new]=unit           } }
  }

  # Print one action group as a labeled tree block
  function print_group(label, arr, n,   i) {
    if (n == 0) return
    printf "  %s\n", label
    for (i = 1; i <= n; i++)
      printf "  %s %s\n", (i == n ? "└─" : "├─"), arr[i]
  }

  # Close the fetch bar. Two-line zone: cursor is at end of secondary bar (line 2).
  function close_fetch(blank) {
    if (!in_progress) return
    kill_anim()
    printf "\r\033[K\n" > "/dev/tty"
    if (blank) printf "\n" > "/dev/tty"
    fflush("/dev/tty")
    in_progress = 0
    fetch_label = ""
  }

  /^\[agenix\]/ || /^decrypting /                      { next }
  /^warning: Git tree .* is dirty/                      { next }
  /^warning: ignoring substitute for /                  { next }
  /^warning: file .* does not exist in binary cache /   { next }
  /^Done\. The new configuration is \/nix\/store\//     { next }
  /^building the system configuration/                  { next }
  /^[[:space:]]+\/nix\/store\//                         { next }
  /^Checking switch inhibitors/                         { next }
  /^activating the configuration/                       { next }
  /^setting up \/etc/                                   { next }
  /^reloading user units for /                          { next }
  /^Skipping "\//                                       { next }
  /^this path will be fetched/                          { next }

  /^these [0-9]+ derivations will be built:/ {
    killspinner()
    close_fetch(0)
    match($0, /[0-9]+/)
    build_total = substr($0, RSTART, RLENGTH) + 0
    build_done = 0
    build_label = ""
    bar = sprintf("%*s", bw, ""); gsub(/ /, "□", bar)
    sec_bar = sprintf("%*s", bw, ""); gsub(/ /, "╌", sec_bar)
    printf "  ⚒  %8s  [%s]    0%%  starting...\033[K\r\n  ⠙  %-8s  [%s]    0%%  \033[K", \
      "0/" build_total, bar, "building", sec_bar > "/dev/tty"
    fflush("/dev/tty")
    in_build = 1
    next
  }

  /^building .*\/nix\/store\// {
    if (!in_build) { next }
    build_done++
    path = $0
    sub(/^building \/nix\/store\/[a-z0-9]+-/, "", path)
    sub(/\.drv.*$/, "", path)
    if (length(path) > 35) path = substr(path, 1, 35)
    build_label = path
    pct    = int(build_done * 100 / (build_total > 0 ? build_total : 1))
    filled = int(build_done * bw  / (build_total > 0 ? build_total : 1))
    bar = ""; sec_bar = ""
    for (i=0; i<filled;    i++) bar = bar "■"
    for (i=0; i<bw-filled; i++) bar = bar "□"
    for (i=0; i<bw;        i++) sec_bar = sec_bar "╌"
    count_str = sprintf("%d/%d", build_done, build_total)
    print "building|" path > statef; close(statef)
    spawn_anim()
    printf "\r\033[1A  ⚒  %8s  [%s]  %3d%%  %s\033[K\r\n\r  ⠙  %-8s  [%s]    0%%\033[K", \
      count_str, bar, pct, build_label, "building", sec_bar > "/dev/tty"
    fflush("/dev/tty")
    next
  }

  /^these [0-9]+ paths will be fetched/ {
    killspinner()
    close_build(0)
    close_fetch(0)
    match($0, /[0-9]+/)
    total = substr($0, RSTART, RLENGTH) + 0
    done = 0
    fetch_label = ""
    bar = sprintf("%*s", bw, ""); gsub(/ /, "□", bar)
    sec_bar = sprintf("%*s", bw, ""); gsub(/ /, "╌", sec_bar)
    printf "  ⬇  %8s  [%s]    0%%  starting...\033[K\r\n  ⠙  %-8s  [%s]    0%%  \033[K", \
      "0/" total, bar, "fetching", sec_bar > "/dev/tty"
    fflush("/dev/tty")
    in_progress = 1
    next
  }

  /^copying path / {
    if (!in_progress) { next }
    done++
    path = $0
    sub(/^copying path \47\/nix\/store\/[a-z0-9]+-/, "", path)
    sub(/\47.*$/, "", path)
    if (length(path) > 35) path = substr(path, 1, 35)
    fetch_label = path
    pct    = int(done * 100 / (total > 0 ? total : 1))
    filled = int(done * bw  / (total > 0 ? total : 1))
    bar = ""; sec_bar = ""
    for (i=0; i<filled;    i++) bar = bar "■"
    for (i=0; i<bw-filled; i++) bar = bar "□"
    for (i=0; i<bw;        i++) sec_bar = sec_bar "╌"
    count_str = sprintf("%d/%d", done, total)
    print "fetching|" path > statef; close(statef)
    spawn_anim()
    printf "\r\033[1A  ⬇  %8s  [%s]  %3d%%  %s\033[K\r\n\r  ⠙  %-8s  [%s]    0%%\033[K", \
      count_str, bar, pct, path, "fetching", sec_bar > "/dev/tty"
    fflush("/dev/tty")
    next
  }

  # Single-unit action lines (e.g. "restarting sysinit-reactivation.target")
  /^(stopping|starting|restarting|reloading) / && !/the following/ {
    if      (/^stopping/)   add_unit("stopped",   $2)
    else if (/^starting/)   add_unit("started",   $2)
    else if (/^restarting/) add_unit("restarted", $2)
    else if (/^reloading/)  add_unit("reloaded",  $2)
    next
  }

  # Multi-unit action lines — buffer all units, print summary in END
  /^(stopping|starting|restarting|reloading) the following .*units?: / ||
  /^the following new units were started: / {
    killspinner()
    close_build(1)
    close_fetch(1)
    idx  = index($0, ": ")
    rest = substr($0, idx + 2)
    n_u  = split(rest, us, ", ")
    if      (/^stopping/)          for (i=1; i<=n_u; i++) add_unit("stopped",   us[i])
    else if (/^starting/)          for (i=1; i<=n_u; i++) add_unit("started",   us[i])
    else if (/^restarting/)        for (i=1; i<=n_u; i++) add_unit("restarted", us[i])
    else if (/^reloading/)         for (i=1; i<=n_u; i++) add_unit("reloaded",  us[i])
    else if (/^the following new/) for (i=1; i<=n_u; i++) add_unit("new",       us[i])
    next
  }

  {
    killspinner()
    close_build(1)
    close_fetch(1)
    print
  }

  END {
    close_build(0)
    close_fetch(0)
    if (n_stopped + n_restarted + n_reloaded + n_started + n_new > 0) {
      htitle = "─── Units Status "
      hfill  = ""; hlen = 58 - length(htitle)
      for (j = 0; j < hlen; j++) hfill = hfill "─"
      close_line = ""
      for (j = 0; j < 58; j++) close_line = close_line "─"
      print ""
      printf "%s%s\n", htitle, hfill
      print_group("Stopped",   stopped_ord,   n_stopped)
      print_group("Restarted", restarted_ord, n_restarted)
      print_group("Reloaded",  reloaded_ord,  n_reloaded)
      print_group("Started",   started_ord,   n_started)
      print_group("New",       new_ord,       n_new)
      printf "%s\n", close_line
    }
  }
  '
}

# ---------------------------------------------------------------------------
# _nixos_run — core rebuild helper used by nr / nru / nrb / nrt
#
# - Shows a clean build header with hostname
# - Holds a systemd sleep/idle inhibit lock for the full build duration
# - Tees all output (stdout + stderr) to a temp log alongside nom
# - Pipes through _nix_fetch_filter: suppresses noise, shows fetch progress
# - After the build: shows a package diff via nvd and calls nixos-log-rebuild
#   to write warnings and a timestamped entry to ~/Obsidian/09 🔄 Updates/
# ---------------------------------------------------------------------------
_nixos_run() {
  local tmplog exit_code old_system _spin_pid
  tmplog=$(mktemp /tmp/nixos-rebuild-XXXXXX.log)
  old_system=$(readlink -f /run/current-system 2>/dev/null)

  # Build header — suppressed when called from nru (which draws its own header)
  if [[ -z "$_NRU_NO_HEADER" ]]; then
    echo ""
    echo "══════════════════════════════════════════════════════════"
    printf "  ↻  Rebuild  ·  %s\n" "$(hostname)"
    echo "══════════════════════════════════════════════════════════"
    echo ""
  fi

  # Secondary-bar animator — sh script written to a temp file, spawned by
  # _nix_fetch_filter when a slow build/fetch package is in progress.
  local _anim_script="/tmp/nru_anim_script_$$"
  local _anim_pid="/tmp/nru_anim_pid_$$"
  local _anim_state="/tmp/nru_anim_state_$$"
  printf '' > "$_anim_pid"
  printf '' > "$_anim_state"
  cat > "$_anim_script" << 'ANIMEOF'
#!/bin/sh
statef="$1"; animpid="$2"
printf '%d\n' "$$" > "$animpid"
sp="⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏"
si=1; step=0; bw=20
while true; do
  schar=$(printf '%s' "$sp" | cut -d' ' -f"$si")
  pct=$(( step < 18 ? step * 5 : 90 ))
  filled=$(( pct * bw / 100 ))
  bar=''; i=0
  while [ "$i" -lt "$filled" ]; do bar="${bar}━"; i=$((i+1)); done
  while [ "$i" -lt "$bw" ]; do bar="${bar}╌"; i=$((i+1)); done
  state=$(cat "$statef" 2>/dev/null)
  act=$(printf '%s' "$state" | cut -d'|' -f1)
  pkg=$(printf '%s' "$state" | cut -d'|' -f2-)
  [ -z "$act" ] && act="fetching"
  printf '\r  %s  %-8s  [%s]  %3d%%\033[K' "$schar" "$act" "$bar" "$pct" > /dev/tty
  sleep 0.1
  si=$(( si % 10 + 1 ))
  step=$(( step < 18 ? step + 1 : 18 ))
done
ANIMEOF
  chmod +x "$_anim_script"

  # Spinner shown during the silent evaluation phase (nix evaluates the flake
  # with no output). &| starts it disowned so zsh never prints "[N] PID" or
  # "[N] Terminated" notifications. _nix_fetch_filter kills it the moment awk
  # first writes any output (build bar, fetch bar, or a pass-through line).
  {
    local -a _sp=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
    local _si=1
    while true; do
      printf "\r  %s  Evaluating…" "${_sp[$_si]}" > /dev/tty
      (( _si = _si % 10 + 1 ))
      sleep 0.1
    done
  } &|
  _spin_pid=$!

  # Run rebuild under a sleep/idle inhibit lock so the machine won't suspend
  # mid-build. systemd-inhibit wraps the command directly — no background job,
  # no "[N] PID" job notification. The lock releases automatically when the
  # command exits, regardless of exit code.
  #
  # _nix_fetch_filter receives the spinner PID so it can kill the spinner
  # before writing its own progress bars to /dev/tty.
  # The log (tee) captures raw output before the filter, so nothing is lost.
  systemd-inhibit --what=sleep:idle --who=nixos-rebuild \
    --why="NixOS rebuild in progress" \
    "$@" 2>&1 | tee "$tmplog" | _nix_fetch_filter "$_spin_pid" "$_anim_script" "$_anim_pid" "$_anim_state"
  exit_code=$pipestatus[1]  # zsh: pipestatus[1] = exit code of "$@"

  # Kill spinner if still running (no build/fetch bars took over), then clear
  # its line so the next output starts on a clean line.
  kill "$_spin_pid" 2>/dev/null
  printf "\r\033[K" > /dev/tty

  # Package diff — only shown on successful switch with real package changes.
  # _fmt_nvd outputs the complete formatted block (header + table + footer +
  # divider), or nothing at all for config-only rebuilds with no package changes.
  if [[ $exit_code -eq 0 ]] && command -v nvd &>/dev/null; then
    local new_system fmt_output
    new_system=$(readlink -f /run/current-system 2>/dev/null)
    if [[ -n "$old_system" && "$old_system" != "$new_system" ]]; then
      fmt_output=$(nvd diff "$old_system" "$new_system" | _fmt_nvd)
      [[ -n "$fmt_output" ]] && printf '%s\n' "$fmt_output"
    fi
  fi

  # Write warnings + update log to vault (non-blocking, never fails the shell).
  # Output is captured silently; the generation number is extracted into
  # _NIXOS_LAST_GEN so callers (nru) can fold it into their success line.
  _NIXOS_LAST_GEN=""
  if command -v nixos-log-rebuild &>/dev/null; then
    local outcome="success" log_out
    [[ $exit_code -eq 1 ]] && outcome="failure"
    log_out=$(nixos-log-rebuild --outcome "$outcome" --log "$tmplog" 2>&1) || true
    _NIXOS_LAST_GEN=$(printf '%s' "$log_out" | grep -oE 'gen [0-9]+' | grep -oE '[0-9]+' | head -1)
  fi

  kill "$(cat "$_anim_pid" 2>/dev/null)" 2>/dev/null || true
  rm -f "$tmplog" "$_anim_script" "$_anim_pid" "$_anim_state"
  return $exit_code
}

# Rebuild and switch to the current flake config.
nr() {
  _nixos_run sudo nixos-rebuild switch --no-link --flake "$NIXOS_CONFIG#$(hostname)"
}

# Test rebuild — activates now without touching the boot entry (safe for risky changes).
nrt() {
  _nixos_run sudo nixos-rebuild test --no-link --flake "$NIXOS_CONFIG#$(hostname)"
}

# ---------------------------------------------------------------------------
# _nru_prompt — displays a formatted (y/n) prompt, returns 0 for yes.
# Usage: _nru_prompt "✓" "message" && do_something
# ---------------------------------------------------------------------------
_nru_prompt() {
  local symbol="$1" msg="$2" reply
  # Read from /dev/tty explicitly — nom alters terminal state and a plain
  # 'read' after the pipeline may have no tty to read from.
  printf "\n  %s  %s  (Y/n)  " "$symbol" "$msg" > /dev/tty
  read -r reply < /dev/tty
  [[ -z "$reply" || "${reply:l}" == y ]]
}

# ---------------------------------------------------------------------------
# _nru_rebuild — runs the rebuild and shows the post-result interactive prompt.
# Kept separate from nru so that a retry skips the git pull / flake update.
# ---------------------------------------------------------------------------
_nru_rebuild() {
  _nixos_run sudo nixos-rebuild switch --no-link --flake "$NIXOS_CONFIG#$(hostname)"
  local exit_code=$?

  if [[ $exit_code -eq 1 ]]; then
    # Exit code 1 = build failure — worth retrying (e.g. network blip fetching a tarball)
    if _nru_prompt "✗" "Rebuild Failed :: Retry Rebuild?"; then
      _nru_rebuild
    fi
    return $exit_code
  elif [[ $exit_code -ne 0 ]]; then
    # Exit code 4 = unit activation warnings (e.g. fwupd-refresh timeout) — build succeeded,
    # retrying won't help. Continue to post-rebuild prompts.
    echo "⚠ Rebuild succeeded with unit warnings (exit $exit_code)"
  fi

  echo "✓ Rebuild successful${_NIXOS_LAST_GEN:+  (generation ${_NIXOS_LAST_GEN})}"

  # Record timestamp so the scheduled auto-update service skips its 3am run
  # if nru was used within the last 20h.
  date +%s > /etc/nixos-last-update-time 2>/dev/null || true

  # Prevent the session-start auto-update service from firing after nru.
  # Without this, the service runs 2 min after login, finds no done file,
  # rebuilds again, and sends a spurious failure notification if there are
  # unit activation warnings (exit 4).
  touch /run/user/$UID/nixos-update-done 2>/dev/null || true

  # Push the updated flake.lock so other hosts get the same nixpkgs pin.
  # Git output is captured and hidden on success; shown in full on failure
  # so auth/divergence errors are never silently swallowed.
  if ! git -C "$NIXOS_CONFIG" diff --quiet flake.lock; then
    echo "→ Pushing updated flake.lock..."
    local git_out
    git -C "$NIXOS_CONFIG" add flake.lock
    if ! git_out=$(git -C "$NIXOS_CONFIG" commit -m "flake: update nixpkgs ($(date +%Y-%m-%d))" 2>&1); then
      printf '%s\n' "$git_out"
    fi
    if git_out=$(git -C "$NIXOS_CONFIG" push 2>&1); then
      printf "  ✓ pushed %s to %s\n" \
        "$(git -C "$NIXOS_CONFIG" rev-parse --short HEAD)" \
        "$(git -C "$NIXOS_CONFIG" branch --show-current)"
    else
      printf '%s\n' "$git_out"
      echo "  ✗ push failed — flake.lock is committed locally, push manually"
    fi
  fi

  # Check if a kernel update requires a reboot
  local current_kernel installed_kernel
  current_kernel=$(uname -r)
  installed_kernel=$(ls /run/current-system/kernel-modules/lib/modules/ 2>/dev/null | head -1)

  if [[ -n "$installed_kernel" && "$current_kernel" != "$installed_kernel" ]]; then
    echo "⚠ Kernel updated: $current_kernel → $installed_kernel"
    curl -s -o /dev/null --max-time 10 \
      -H "Title: Reboot Required — $(hostname)" \
      -H "Priority: high" \
      -H "Tags: warning,arrows_counterclockwise" \
      -d "Kernel updated (${installed_kernel}). Reboot when convenient." \
      "http://media-server:2586/nixos-updates" 2>/dev/null || true
    if _nru_prompt "⚠" "Rebuild Clean :: Requires Reboot :: Do it now?"; then
      sudo reboot
    fi
  else
    if _nru_prompt "✓" "Rebuild Clean :: Close Terminal?"; then
      exit 0
    fi
  fi
}

# ---------------------------------------------------------------------------
# nru display constants — Nerd Font icons and full bar used across all
# update progress lines. Defined once so every function stays consistent.
#   _NRU_GH   = U+F09B  GitHub logo (Font Awesome via Nerd Fonts)
#   _NRU_NIX  = U+F1105 Nix snowflake (Nerd Fonts)
#   _NRU_DONE = pre-filled 20-char bar — used for "already up to date" lines
# ---------------------------------------------------------------------------
_NRU_GH="󰊤"     # U+F02A4 nf-md-github (Nerd Fonts) — 2-cell wide
_NRU_NIX="󱄅"   # U+F1105 nf-linux-nixos (Nerd Fonts) — 2-cell wide (same as _NRU_GH)
_NRU_DONE="[■■■■■■■■■■■■■■■■■■■■]"

# ---------------------------------------------------------------------------
# _nru_pkg_bar — animated fake-progress bar for a single update step.
# Runs cmd in background; shows  ICON  NAME      [bar]  pct%  while running.
# On success: fills bar to 100% and appends INFO  ✓
# On failure: shows ✗ and dumps the captured log.
#
# Usage: _nru_pkg_bar ICON NAME INFO cmd [args...]
# ---------------------------------------------------------------------------
_nru_pkg_bar() {
  local icon="$1" name="$2" info="$3"
  shift 3

  local bw=20 bar i filled pct step=0
  local _xf="/tmp/nru_pkg_bar_$$.exit"
  rm -f "$_xf"

  # &| disowns immediately (no job notifications); exit code written to file
  # because wait cannot track a disowned pid in zsh.
  { "$@" >/tmp/nru_pkg_bar.log 2>&1; echo $? >"$_xf" } &|
  local pid=$!

  while kill -0 "$pid" 2>/dev/null; do
    pct=$(( step < 18 ? step * 5 : 90 ))
    filled=$(( pct * bw / 100 ))
    bar=""
    for (( i=0; i<filled; i++ )); do bar+="■"; done
    for (( i=filled; i<bw; i++ )); do bar+="□"; done
    printf "\r  %s  %-12s  [%s]  %d%%\033[K" \
      "$icon" "$name" "$bar" "$pct" >/dev/tty
    sleep 0.1
    step=$(( step < 18 ? step + 1 : 18 ))
  done

  # Brief spin waiting for the exit file to be flushed after the process exits
  local _r=0
  while [[ ! -f "$_xf" ]] && (( _r++ < 50 )); do sleep 0.01; done
  local code=1
  [[ -f "$_xf" ]] && code=$(< "$_xf")
  rm -f "$_xf"

  if [[ $code -eq 0 ]]; then
    bar=""; for (( i=0; i<bw; i++ )); do bar+="■"; done
    printf "\r  %s  %-12s  [%s]  %s  ✓\033[K\n" \
      "$icon" "$name" "$bar" "$info" >/dev/tty
  else
    printf "\r  %s  %-12s  ✗ update failed\033[K\n" "$icon" "$name" >/dev/tty
    [[ -s /tmp/nru_pkg_bar.log ]] && cat /tmp/nru_pkg_bar.log
  fi

  return $code
}

# ---------------------------------------------------------------------------
# _nru_nixpkgs_bar — updates nixpkgs in background with a progress bar,
# then shows the old→new date on the completed bar line.
# ---------------------------------------------------------------------------
_nru_nixpkgs_bar() {
  local bw=20 bar i filled pct step=0
  local icon="$_NRU_NIX"

  local _xf="/tmp/nru_nixpkgs_$$.exit"
  rm -f "$_xf"
  { nix flake update nixpkgs --flake "$NIXOS_CONFIG" >/tmp/nru_nixpkgs.log 2>&1; echo $? >"$_xf" } &|
  local pid=$!

  while kill -0 "$pid" 2>/dev/null; do
    pct=$(( step < 18 ? step * 5 : 90 ))
    filled=$(( pct * bw / 100 ))
    bar=""
    for (( i=0; i<filled; i++ )); do bar+="■"; done
    for (( i=filled; i<bw; i++ )); do bar+="□"; done
    printf "\r  %s  %-12s  [%s]  %d%%\033[K" \
      "$icon" "NixPkgs" "$bar" "$pct" >/dev/tty
    sleep 0.1
    step=$(( step < 18 ? step + 1 : 18 ))
  done

  local _r=0
  while [[ ! -f "$_xf" ]] && (( _r++ < 50 )); do sleep 0.01; done
  local code=1
  [[ -f "$_xf" ]] && code=$(< "$_xf")
  rm -f "$_xf"
  local upd_out
  upd_out=$(cat /tmp/nru_nixpkgs.log)

  if [[ $code -ne 0 ]]; then
    printf "\r  %s  %-12s  ✗ update failed\033[K\n" "$icon" "NixPkgs" >/dev/tty
    printf '%s\n' "$upd_out"
    return $code
  fi

  bar=""; for (( i=0; i<bw; i++ )); do bar+="■"; done

  if printf '%s' "$upd_out" | grep -q "Updated input 'nixpkgs'"; then
    local info
    info=$(printf '%s' "$upd_out" | awk '
      /github:nixos\/nixpkgs\/[0-9a-f]{40}/ {
        match($0, /\([0-9]{4}-[0-9]{2}-[0-9]{2}\)/); dt = substr($0, RSTART+1, 10)
        if (!seen) { old_dt=dt; seen=1 }
        else printf "%s → %s", old_dt, dt
      }')
    printf "\r  %s  %-12s  [%s]  %s  ✓\033[K\n" \
      "$icon" "NixPkgs" "$bar" "$info" >/dev/tty
  else
    printf "\r  %s  %-12s  %s  up to date  ✓\033[K\n" \
      "$icon" "NixPkgs" "$_NRU_DONE" >/dev/tty
  fi
}

# ---------------------------------------------------------------------------
# _nru_update_proton_ge — checks GitHub for a new GE-Proton release and
# updates the flake.nix input URL if needed, then refreshes flake.lock.
# ---------------------------------------------------------------------------
_nru_update_proton_ge() {
  local latest current

  latest=$(curl -fsSL "https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest" \
    | jq -r '.tag_name' 2>/dev/null) || {
    printf "  %s  %-12s  %s  ⚠ GitHub unreachable\n" "$_NRU_GH" "GE-Proton" "$_NRU_DONE"
    return 0
  }

  current=$(grep -oE 'GE-Proton[0-9]+-[0-9]+' "$NIXOS_CONFIG/flake.nix" | head -1)

  if [[ "$latest" == "$current" ]]; then
    printf "  %s  %-12s  %s  %s  ✓\n" "$_NRU_GH" "GE-Proton" "$_NRU_DONE" "$current"
    return 0
  fi

  local _cur="$current" _lat="$latest" _cfg="$NIXOS_CONFIG"
  _nru_pkg_bar "$_NRU_GH" "GE-Proton" "$_lat" \
    zsh -c "sed -i 's|${_cur}|${_lat}|g' \"${_cfg}/flake.nix\" \
      && nix flake update proton-ge-custom --flake \"${_cfg}\""
}

# ---------------------------------------------------------------------------
# _nru_update_goverlay — checks GitHub for a new GOverlay release and
# updates the flake.nix input URL + version string if needed.
# ---------------------------------------------------------------------------
_nru_update_goverlay() {
  local latest current

  latest=$(curl -fsSL "https://api.github.com/repos/benjamimgois/goverlay/releases/latest" \
    | jq -r '.tag_name' 2>/dev/null) || {
    printf "  %s  %-12s  %s  ⚠ GitHub unreachable\n" "$_NRU_GH" "GOverlay" "$_NRU_DONE"
    return 0
  }

  current=$(grep -oE 'refs/tags/[0-9]+\.[0-9]+\.[0-9]+\.tar' "$NIXOS_CONFIG/flake.nix" \
    | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)

  if [[ "$latest" == "$current" ]]; then
    printf "  %s  %-12s  %s  %s  ✓\n" "$_NRU_GH" "GOverlay" "$_NRU_DONE" "$current"
    return 0
  fi

  local _cur="$current" _lat="$latest" _cfg="$NIXOS_CONFIG"
  _nru_pkg_bar "$_NRU_GH" "GOverlay" "$_lat" \
    zsh -c "
      sed -i 's|refs/tags/${_cur}\.tar|refs/tags/${_lat}.tar|g' \"${_cfg}/flake.nix\"
      sed -i 's|version = \"${_cur}\"; # goverlay-nru|version = \"${_lat}\"; # goverlay-nru|g' \"${_cfg}/flake.nix\"
      nix flake update goverlay-src --flake \"${_cfg}\"
    "
}

# ---------------------------------------------------------------------------
# _nru_git_bar — pulls latest nixos-config with animated progress bar.
# Restores flake.lock first to avoid merge conflicts with local nix updates.
# ---------------------------------------------------------------------------
_nru_git_bar() {
  local bw=20 bar i filled pct step=0
  local _xf="/tmp/nru_git_$$.exit"
  rm -f "$_xf"

  git -C "$NIXOS_CONFIG" restore flake.lock 2>/dev/null || true

  { git -C "$NIXOS_CONFIG" pull >/tmp/nru_git_$$.log 2>&1; echo $? >"$_xf" } &|
  local pid=$!

  while kill -0 "$pid" 2>/dev/null; do
    pct=$(( step < 18 ? step * 5 : 90 ))
    filled=$(( pct * bw / 100 ))
    bar=""
    for (( i=0; i<filled; i++ )); do bar+="■"; done
    for (( i=filled; i<bw; i++ )); do bar+="□"; done
    printf "\r  %s  %-12s  [%s]  %d%%\033[K" \
      "$_NRU_GH" "Nixos-Config" "$bar" "$pct" >/dev/tty
    sleep 0.1
    step=$(( step < 18 ? step + 1 : 18 ))
  done

  local _r=0
  while [[ ! -f "$_xf" ]] && (( _r++ < 50 )); do sleep 0.01; done
  local code=1
  [[ -f "$_xf" ]] && code=$(< "$_xf")
  rm -f "$_xf"
  local git_out
  git_out=$(cat /tmp/nru_git_$$.log 2>/dev/null)
  rm -f "/tmp/nru_git_$$.log"

  bar=""; for (( i=0; i<bw; i++ )); do bar+="■"; done

  if [[ $code -ne 0 ]]; then
    printf "\r  %s  %-12s  ✗ pull failed\033[K\n" "$_NRU_GH" "Nixos-Config" >/dev/tty
    printf '%s\n' "$git_out"
    return 1
  fi

  if printf '%s' "$git_out" | grep -q "Already up to date"; then
    printf "\r  %s  %-12s  %s  up to date  ✓\033[K\n" "$_NRU_GH" "Nixos-Config" "$_NRU_DONE" >/dev/tty
  else
    printf "\r  %s  %-12s  [%s]  updated  ✓\033[K\n" "$_NRU_GH" "Nixos-Config" "$bar" >/dev/tty
  fi
}

# ---------------------------------------------------------------------------
# Rebuild + pull latest nixpkgs before switching.
# Pulls latest git changes, bumps nixpkgs + GitHub packages in flake.lock,
# rebuilds, commits the updated flake.lock, then prompts based on result:
#   clean        → offer to close terminal
#   needs reboot → offer to reboot now
#   failed       → offer to retry (without re-pulling or re-updating)
# ---------------------------------------------------------------------------
nru() {
  # ── Header ──────────────────────────────────────────────────────────────────
  echo ""
  echo "══════════════════════════════════════════════════════════"
  printf "  ↻  Update & Rebuild  ·  %s\n" "$(hostname)"
  echo "══════════════════════════════════════════════════════════"
  echo ""

  # ── Git pull ─────────────────────────────────────────────────────────────────
  _nru_git_bar || return 1

  # ── nixpkgs ──────────────────────────────────────────────────────────────────
  _nru_nixpkgs_bar || return 1

  # ── GitHub packages (gaming hosts only) ─────────────────────────────────────
  command -v steam   &>/dev/null && { _nru_update_proton_ge || true }
  command -v goverlay &>/dev/null && { _nru_update_goverlay  || true }

  # ── Rebuild ───────────────────────────────────────────────────────────────────
  echo ""
  _NRU_NO_HEADER=1 _nru_rebuild
}

# NixOS aliases — available to all users on all hosts
alias nrr='sudo nixos-rebuild switch --rollback'
alias ngc='sudo nix-collect-garbage --delete-older-than 30d'
alias ngens='sudo nix-env --list-generations --profile /nix/var/nix/profiles/system'

# ---------------------------------------------------------------------------
# OpenCode — runs with OpenRouter API (key from agenix)
# ---------------------------------------------------------------------------
opencode() {
  ANTHROPIC_API_KEY="$(cat /run/agenix/openrouter-api-key 2>/dev/null)" \
  ANTHROPIC_BASE_URL="https://openrouter.ai/api" \
  command opencode "$@"
}

