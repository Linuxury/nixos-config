# ---------------------------------------------------------------------------
# _fmt_nvd — formats nvd diff output into a clean aligned package-changes table.
#
# Collects all package data into arrays first, then renders in one pass so
# column widths can be computed from the actual data before the first row prints.
# Outputs the complete formatted block (header + table + footer + divider).
# Outputs nothing if no meaningful package changes are found.
# Handles both nvd long-form ("Added packages:") and short-form ([A]/[U]/[R]) output.
# ---------------------------------------------------------------------------
_fmt_nvd() {
  local section="" line
  # All loop variables declared here — zsh prints "var=value" if `local` is
  # re-run without assignment on an already-declared variable, so declaring
  # inside the while loop leaks values to the output.
  local pkg ver name old_v new_v rest old_vset new_vset
  local -a names=() old_vers=() new_vers=() actions=()
  local closure_old="" closure_new="" closure_added="" closure_removed="" closure_net="" closure_disk=""

  while IFS= read -r line; do
    [[ "$line" == '<<<'* || "$line" == '>>>'* ]] && continue
    [[ -z "${line// }" ]] && continue

    # Long-form section headers
    if [[ "$line" == 'Added packages:'   ]]; then section="added";   continue; fi
    if [[ "$line" == 'Removed packages:' ]]; then section="removed"; continue; fi
    if [[ "$line" == 'Version changes:'* ]]; then section="version"; continue; fi

    # Closure size line — extract all stats for the footer
    if [[ "$line" == 'Closure size:'* ]]; then
      closure_old=$(    printf '%s' "$line" | sed -E 's/Closure size: ([0-9]+).*/\1/')
      closure_new=$(    printf '%s' "$line" | sed -E 's/[^0-9]*[0-9]+ -> ([0-9]+).*/\1/')
      closure_added=$(  printf '%s' "$line" | sed -E 's/.*\(([0-9]+) paths added.*/\1/')
      closure_removed=$(printf '%s' "$line" | sed -E 's/.*, ([0-9]+) paths removed.*/\1/')
      closure_net=$(    printf '%s' "$line" | sed -E 's/.*delta ([+-]?[0-9]+).*/\1/')
      closure_disk=$(   printf '%s' "$line" | sed -E 's/.*disk usage ([^)]+)\).*/\1/')
      continue
    fi

    # Short-form prefix — update section from marker
    case "$line" in
      '[A.'*|'[A*'*|'[A+'*|'[A-'*) section="added"   ;;
      '[R.'*|'[R*'*|'[R+'*|'[R-'*) section="removed" ;;
      '[C.'*|'[C*'*|'[C+'*|'[C-'*|'[D.'*|'[D*'*|'[D+'*|'[D-'*|'[U.'*|'[U*'*|'[U+'*|'[U-'*) section="version" ;;
    esac

    case "$section" in
      added|removed)
        pkg=$(printf '%s' "$line" | sed -E 's/^\[[A-Z].\]  #[0-9]+  //; s/^[a-z0-9]{32,}-//')
        [[ -z "$pkg" ]] && continue
        ver="${pkg##*  }"
        pkg="${pkg%%  *}"
        [[ "$pkg" == "source" || "$pkg" == "home-manager-"* || "$pkg" == "hm_"* || "$pkg" == "activation-script" || "$pkg" == "unit-"* ]] && continue
        ver=$(printf '%s' "$ver" | sed 's/, .*//')
        [[ "$ver" == "<none>" ]] && ver=$section   # unversioned (scripts): say added/removed
        names+=("$pkg")
        actions+=("$section")
        if [[ "$section" == "added" ]]; then
          old_vers+=("-"); new_vers+=("$ver")
        else
          old_vers+=("$ver"); new_vers+=("-")
        fi
        ;;
      version)
        pkg=$(printf '%s' "$line" | sed -E 's/^\[[A-Z][.*]\]  //')
        [[ -z "$pkg" ]] && continue
        pkg=$(printf '%s' "$pkg" | sed -E 's/^#[0-9]+  +//')
        [[ -z "$pkg" ]] && continue
        [[ "$pkg" != *' -> '* ]] && continue
        name="${pkg%% *}"
        rest="${pkg#"$name"}"; rest="${rest#"${rest%%[! ]*}"}"
        old_v="${rest%% -> *}"; new_v="${rest##* -> }"
        # Strip multi-output noise (", 2.63.1-man") — keep only the first version token
        old_v=$(printf '%s' "$old_v" | sed 's/, .*//')
        new_v=$(printf '%s' "$new_v" | sed 's/, .*//')
        # Skip count-only closure changes (x3 → x2) — version itself didn't change
        old_vset=$(printf '%s' "$old_v" | sed -E 's/ x[0-9]+//g')
        new_vset=$(printf '%s' "$new_v" | sed -E 's/ x[0-9]+//g')
        [[ "$old_vset" == "$new_vset" ]] && continue
        old_v=$(printf '%s' "$old_v" | sed -E 's/ x[0-9]+//')
        new_v=$(printf '%s' "$new_v" | sed -E 's/ x[0-9]+//')
        names+=("$name"); old_vers+=("$old_v"); new_vers+=("$new_v"); actions+=("updated")
        ;;
    esac
  done

  local n_total=${#names[@]}
  # Same-version rebuilds (git-built flake inputs) have no rows — say so instead of nothing.
  if (( n_total == 0 )); then
    (( ${closure_added:-0} > 0 )) || return
    local t="─── Packages  ·  no version changes  ·  ${closure_added} rebuilt "
    local n=$(( 58 - ${#t} )); (( n < 0 )) && n=0
    printf '\n%s%s\n' "$t" "${(l:n::─:)}"
    return
  fi

  # Count by action type
  local n_updated=0 n_added=0 n_removed=0 a
  for a in "${actions[@]}"; do
    case "$a" in updated) (( n_updated++ ));; added) (( n_added++ ));; removed) (( n_removed++ ));; esac
  done

  # Dynamic column widths — computed from actual data so the table is always tight
  local max_name=7 max_from=4 i  # floor = header label lengths ("Package", "From")
  for (( i=1; i<=n_total; i++ )); do
    [[ ${#names[$i]} -gt $max_name ]] && max_name=${#names[$i]}
    [[ ${#old_vers[$i]} -gt $max_from ]] && max_from=${#old_vers[$i]}
  done
  local col_name=$(( max_name + 2 )) col_from=$(( max_from + 4 ))

  # Section header: "─── Packages  ·  N updated  ·  +64.8 MiB ───..."
  local hparts="" j
  [[ $n_updated -gt 0 ]] && hparts="${n_updated} updated"
  [[ $n_added   -gt 0 ]] && hparts="${hparts:+${hparts}  ·  }${n_added} added"
  [[ $n_removed -gt 0 ]] && hparts="${hparts:+${hparts}  ·  }${n_removed} removed"
  [[ -n "$closure_disk" ]] && hparts="${hparts:+${hparts}  ·  }${closure_disk}"
  local htitle="─── Packages  ·  ${hparts} "
  local hfill="" hlen=$(( 58 - ${#htitle} ))
  for (( j=0; j<hlen; j++ )); do hfill="${hfill}─"; done

  # Table separator and closing divider
  local sep="" close="" sep_len=$(( col_name + col_from + 22 ))
  for (( j=0; j<sep_len; j++ )); do sep="${sep}─"; done
  for (( j=0; j<58; j++ )); do close="${close}─"; done

  # Render
  echo ""
  printf '%s%s\n' "$htitle" "$hfill"
  echo ""
  printf "  %-${col_name}s  %-${col_from}s  %s\n" "Package" "From" "To"
  printf "  %s\n" "$sep"
  # Notable packages first (kernel, browsers, graphics, init), then nvd's order.
  local -a order rest
  for (( i=1; i<=n_total; i++ )); do
    if [[ ${names[$i]} == (linux|linux-*|firefox*|zen*|helium*|chromium*|mesa*|systemd|nvidia*|steam*) ]]; then
      order+=($i)
    else
      rest+=($i)
    fi
  done
  for i in $order $rest; do
    printf "  %-${col_name}s  %-${col_from}s  %s\n" "${names[$i]}" "${old_vers[$i]}" "${new_vers[$i]}"
  done
  echo ""
  [[ -n "$closure_old" && -n "$closure_new" ]] && \
    printf "  Store paths: %s → %s  (%s new, %s removed, net %s)\n" \
      "$closure_old" "$closure_new" "$closure_added" "$closure_removed" "$closure_net"
  [[ -n "$closure_disk" ]] && printf "  Disk usage:  %s\n" "$closure_disk"
  echo ""
  printf '%s\n' "$close"
}

# ---------------------------------------------------------------------------
# nru shared state + helpers
#
# Rows for each update step go to /dev/tty so \r can redraw the same line;
# trees, raw dumps and summaries go to stdout.
# ---------------------------------------------------------------------------
zmodload zsh/datetime   # EPOCHSECONDS for timers
_NRU_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/nru"   # last-failure.log, last-units.txt, last-packages.txt
_NRU_GH="󰊤"     # U+F02A4 nf-md-github (Nerd Fonts) — 2-cell wide
_NRU_NIX="󱄅"   # U+F1105 nf-linux-nixos (Nerd Fonts) — 2-cell wide (same as _NRU_GH)
_NRU_FP="󰏖"    # U+F03D6 nf-md-package_variant — same glyph fastfetch uses for flatpak count
_NRU_DONE="[■■■■■■■■■■■■■■■■■■■■]"
_NRU_SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)

# Only linuxury@Ryzen5900x writes shared state (flake.lock, proton bump, hash
# fixes) and pushes it — every other host just pulls. Two writers = guaranteed
# lock conflicts (ThinkPad stranded a lock commit 2026-09-27 that broke nru
# on 2026-10-10).
_nru_is_lock_writer() { [[ "$(whoami)" == linuxury && "$(hostname)" == Ryzen5900x ]] }

# Final row for a step:              _nru_row ICON NAME TEXT
_nru_row() { printf "\r  %s  %-12s  %s\033[K\n" "$1" "$2" "$3" >/dev/tty }
# Completed row with a full bar:     _nru_ok ICON NAME INFO [SUFFIX]
_nru_ok()  { printf "\r  %s  %-12s  %s  %s  ✓%s\033[K\n" "$1" "$2" "$_NRU_DONE" "$3" "${4:+  $4}" >/dev/tty }
# Tree under a row, one arg per item
_nru_tree() {
  local i b
  for (( i = 1; i <= $#; i++ )); do
    b="├─"; (( i == $# )) && b="└─"
    printf "       %s %s\n" "$b" "${@[i]}"
  done
}

# _nru_wait_exit FILE — waits briefly for a background job's exit-code file,
# prints the code (1 if it never appeared) and removes the file.
_nru_wait_exit() {
  local r=0 code=1
  while [[ ! -f "$1" ]] && (( r++ < 50 )); do sleep 0.01; done
  [[ -f "$1" ]] && code=$(<"$1")
  rm -f "$1"
  print -r -- "$code"
}

# ---------------------------------------------------------------------------
# _nru_spin — runs a command in the background behind a spinner, for steps
# with no measurable progress (no fake bar). Elapsed time shows after 3s.
# Output goes to LOG; returns the command's exit code. Leaves the spinner on
# the line so the caller can overwrite it with its own final row (\r).
#
# Usage: _nru_spin ICON NAME TEXT LOG cmd [args...]
#   →  "  󰊤  Nixos-Config  ⠹ pulling…  4s"
# ---------------------------------------------------------------------------
_nru_spin() {
  local icon=$1 name=$2 text=$3 log=$4; shift 4
  local xf="$_NRU_CACHE/.exit.$$" t0=$EPOCHSECONDS el i=1
  mkdir -p "$_NRU_CACHE"; rm -f "$xf"

  # &| disowns immediately (no job notifications); exit code goes to a file
  # because wait cannot track a disowned pid in zsh.
  { "$@" >"$log" 2>&1; echo $? >"$xf" } &|
  local pid=$!

  while kill -0 "$pid" 2>/dev/null; do
    el=$(( EPOCHSECONDS - t0 ))
    printf "\r  %s  %-12s  %s %s…%s\033[K" "$icon" "$name" "$_NRU_SPIN[i]" "$text" \
      "${${el:#[012]}:+  ${el}s}" >/dev/tty
    sleep 0.1
    i=$(( i % 10 + 1 ))
  done

  return $(_nru_wait_exit "$xf")
}

# ---------------------------------------------------------------------------
# _nru_menu — one-line menu on /dev/tty; prints the chosen key (lowercase).
# The uppercase key is the default, picked by Enter.
#
# Usage: choice=$(_nru_menu "⚠" "Title" "S:Stash & pull" "d:discard & pull" "q:quit")
#   → "  ⚠  Title  ·   [S]tash & pull   [d]iscard & pull   [q]uit  › "
# ---------------------------------------------------------------------------
_nru_menu() {
  local sym=$1 title=$2 opt k l keys="" def="" line="" reply; shift 2
  for opt in "$@"; do
    k=${opt%%:*}; l=${opt#*:}
    [[ $k == [[:upper:]] ]] && def=${k:l}
    keys+=${k:l}
    if [[ ${l[1]:l} == ${k:l} ]]; then line+="   [$k]${l[2,-1]}"; else line+="   [$k] $l"; fi
  done
  while true; do
    printf "\n  %s  %s  ·%s  › " "$sym" "$title" "$line" >/dev/tty
    read -r reply </dev/tty
    reply=${${reply:l}[1]}
    [[ -z $reply ]] && reply=$def
    [[ -n $reply && $keys == *$reply* ]] && { print -r -- "$reply"; return 0 }
  done
}

# ---------------------------------------------------------------------------
# _nru_ticker — draws the live rebuild line at 10 Hz until killed.
#
# The awk filter never draws progress itself — it writes the current state
# ("eval" or "fetch|done|total|label" / "build|…") to a state file and this
# single background loop renders it with a spinner, plus elapsed time once one
# item has taken 10s+. An empty state file means "don't draw" (awk clears it
# and waits 0.15s before printing a normal line, so the two never collide).
# ---------------------------------------------------------------------------
_nru_ticker() {
  local statef=$1 st kind cnt tot lbl last="" since=$EPOCHSECONDS el f pct sfx icon e="" i=1
  while true; do
    st=$(<"$statef") 2>/dev/null
    if [[ $st == eval ]]; then
      printf "\r  %s  Evaluating…\033[K" "$_NRU_SPIN[i]" >/dev/tty
    elif [[ -n $st ]]; then
      IFS='|' read -r kind cnt tot lbl <<< "$st"
      [[ ${lbl%% \[*} != "$last" ]] && { last=${lbl%% \[*}; since=$EPOCHSECONDS }   # per package, not per [n/m] step
      el=$(( EPOCHSECONDS - since )); sfx=""
      (( el >= 10 )) && sfx=$(printf '  %dm%02ds' $(( el / 60 )) $(( el % 60 )))
      (( tot > 0 )) || tot=1
      pct=$(( cnt * 100 / tot )); f=$(( cnt * 20 / tot ))
      [[ $kind == fetch ]] && icon="⬇" || icon="⚒"
      printf "\r  %s  %-12s  [%s%s]  %3d%%  %-30s %s%s\033[K" "$icon" "$cnt/$tot" \
        "${(l:f::■:)e}" "${(l:20-f::□:)e}" "$pct" "$lbl" "$_NRU_SPIN[i]" "$sfx" >/dev/tty
    fi
    sleep 0.1
    i=$(( i % 10 + 1 ))
  done
}

# ---------------------------------------------------------------------------
# _nix_fetch_filter — stdin filter used by _nixos_run.
#
#   - Build noise (agenix, store paths, systemd-run chatter): dropped
#   - "these N derivations will be built" / "building …":    ⚒ progress
#   - "these N paths will be fetched" / "copying path …":    ⬇ progress
#     Repeated rounds add to the same bar instead of starting a new one;
#     the final ⬇/⚒ lines print once, before the first normal line or at the end.
#   - Unit start/stop/restart lines: counted, summarised at the end
#   - Everything from the first "error:" on: hidden — _nixos_run prints a
#     summary and saves the full log instead
#   - Everything else (activation, warnings): passed through
#
# Args: STATE_FILE (read by _nru_ticker), CACHE_DIR (stats + unit list)
# ---------------------------------------------------------------------------
_nix_fetch_filter() {
  awk -v statef="$1" -v cachedir="$2" '
  BEGIN { bw=20; ft=0; fd=0; bt=0; bd=0; kind=""; label=""; active=0; err=0
          cur="eval"   # what the ticker is drawing right now ("" = nothing)
          fetched=0; built=0; dl_mib=0
          n_stopped=0; n_restarted=0; n_reloaded=0; n_started=0; n_new=0; n_failed=0 }

  function state() {
    cur = (kind == "fetch") ? sprintf("fetch|%d|%d|%s", fd, ft, label) : sprintf("build|%d|%d|%s", bd, bt, label)
    printf "%s\n", cur > statef; close(statef)
  }
  # Pause the ticker and clear its line (it waits 0.15s so a frame in flight lands first).
  function quiet() {
    printf "" > statef; close(statef)
    system("sleep 0.15")
    printf "\r\033[K" > "/dev/tty"; fflush("/dev/tty")
  }
  # Stop the ticker for good (bars done, error, or activation started).
  function stop() { if (cur == "") return; quiet(); cur = "" }
  # Print a normal line without colliding with the ticker, then let it resume
  # (e.g. a warning during "Evaluating…").
  function say(line) {
    if (cur != "") quiet()
    print line; fflush()
    if (cur != "") { printf "%s\n", cur > statef; close(statef) }
  }
  function bar(d, t,   f, s, i) {
    f = int(d * bw / (t > 0 ? t : 1)); s = ""
    for (i = 0; i < f; i++) s = s "■"
    for (; i < bw; i++) s = s "□"
    return s
  }
  function size(m) { return m >= 1024 ? sprintf("%.1f GiB", m / 1024) : sprintf("%.0f MiB", m) }
  # Print the final ⬇ / ⚒ lines once; later rounds (rare) start fresh bars.
  function finals() {
    stop()
    if (!active) return
    if (ft) printf "  ⬇  %-12s  [%s]  %3d%%  %s\n", fd "/" ft, bar(fd, ft), int(fd * 100 / ft), size(dl_mib) > "/dev/tty"
    if (bt) {
      if (err) printf "  ⚒  %-12s  [%s]  %3d%%  stopped\n", bd "/" bt, bar(bd, bt), int(bd * 100 / bt) > "/dev/tty"
      else     printf "  ⚒  %-12s  [%s]  100%%  %s\n", bt "/" bt, bar(1, 1), (bd < bt ? "cached" : "built") > "/dev/tty"
    }
    fflush("/dev/tty")
    active = 0; ft = 0; fd = 0; bt = 0; bd = 0
  }
  # "these 98 derivations …" → 98; singular "this path …" → 1 (its first number is the size)
  function count(l) { return (l ~ /^these [0-9]+/ && match(l, /[0-9]+/)) ? substr(l, RSTART, RLENGTH) + 0 : 1 }
  function add_unit(action, unit) {
    if (action == "stopped")   { if (!stopped_seen[unit])   { stopped_seen[unit]=1;   stopped_ord[++n_stopped]=unit   } }
    if (action == "restarted") { if (!restarted_seen[unit]) { restarted_seen[unit]=1; restarted_ord[++n_restarted]=unit } }
    if (action == "reloaded")  { if (!reloaded_seen[unit])  { reloaded_seen[unit]=1;  reloaded_ord[++n_reloaded]=unit  } }
    if (action == "started")   { if (!started_seen[unit])   { started_seen[unit]=1;   started_ord[++n_started]=unit   } }
    if (action == "new")       { if (!new_seen[unit])       { new_seen[unit]=1;       new_ord[++n_new]=unit           } }
    if (action == "failed")    { if (!failed_seen[unit])    { failed_seen[unit]=1;    failed_ord[++n_failed]=unit     } }
  }
  function list_group(label, arr, n,   i) {
    if (n == 0) return
    printf "%s\n", label > unitsf
    for (i = 1; i <= n; i++) printf "  %s\n", arr[i] > unitsf
  }

  { l = tolower($0) }

  # After the first error, nothing more goes to the screen.
  err                                                   { next }
  /^[[:space:]]*error:/                                 { finals(); err = 1; next }

  /^\[agenix\]/ || /^decrypting /                      { next }
  # Eval-time warnings already get parsed from the log by nixos-log-rebuild
  # and shown in the "Flagged" block after the build.
  /^evaluation warning:/                                { next }
  /^warning: Git tree .* is dirty/                      { next }
  /^warning: ignoring substitute for /                  { next }
  /^warning: file .* does not exist in binary cache /   { next }
  /^Done\. The new configuration is \/nix\/store\//     { next }
  /^building the system configuration/                  { next }
  /^[[:space:]]+\/nix\/store\//                         { next }
  /^Checking switch inhibitors/                         { next }
  /^activating the configuration/                       { next }
  /^setting up \/etc/                                   { next }
  /^reloading user units for /                          { next }
  /^Skipping "\//                                       { next }
  /^unpacking \47.*\47 into the Git cache/               { next }
  /^NOT restarting the following (changed|user) units:/  { next }
  # systemd-run chatter from switch-to-configuration — the wall-clock time is
  # pulled from the raw log by _nixos_run and shown on the success line.
  /^Start(ing|ed) \[systemd-run\] /                        { next }
  /^(switching|finished switching) to system configuration / { next }
  /^nixos-rebuild-switch-to-configuration\.service: (Deactivated|Consumed) / { next }

  # nix prints the singular form ("This derivation will be built:") for one item
  l ~ /^(these [0-9]+ derivations|this derivation) will be built/ {
    bt += count(l); kind = "build"; label = "starting…"; active = 1; state(); next
  }
  # -L build-log lines ("noctalia> [312/840] Compiling …"): never shown, but
  # they name the package that is ACTUALLY busy — "building" lines only say
  # what started last, and nix never prints when a build finishes.
  bt && /^[A-Za-z0-9][A-Za-z0-9._+-]*> / {
    pkg = substr($0, 1, index($0, ">") - 1); step = ""
    if (match($0, /\[[0-9]+\/[0-9]+\]/)) step = " " substr($0, RSTART, RLENGTH)
    if (pkg step != label) { label = substr(pkg, 1, 30 - length(step)) step; kind = "build"; state() }
    next
  }
  /^building .*\/nix\/store\// {
    if (!bt) next
    bd++; built++
    path = $0
    sub(/^building \47?\/nix\/store\/[a-z0-9]+-/, "", path)
    sub(/\.drv.*$/, "", path)
    label = substr(path, 1, 30); kind = "build"; state(); next
  }
  l ~ /^(these [0-9]+ paths|this path) will be fetched/ {
    ft += count(l)
    if (match(l, /[0-9.]+ [kmg]ib download/)) {
      split(substr(l, RSTART, RLENGTH), a, " ")
      dl_mib += (a[2] == "kib" ? a[1] / 1024 : a[2] == "gib" ? a[1] * 1024 : a[1])
    }
    kind = "fetch"; label = "starting…"; active = 1; state(); next
  }
  /^copying path / {
    if (!ft) next
    fd++; fetched++
    path = $0
    sub(/^copying path \47\/nix\/store\/[a-z0-9]+-/, "", path)
    sub(/\47.*$/, "", path)
    label = substr(path, 1, 30); kind = "fetch"; state(); next
  }

  # Units that failed to start during the switch
  /^warning: the following units failed: / {
    rest = $0; sub(/^.*units failed: /, "", rest)
    n_u = split(rest, us, ", ")
    for (i = 1; i <= n_u; i++) add_unit("failed", us[i])
    next
  }
  # Single-unit action lines (e.g. "restarting sysinit-reactivation.target")
  /^(stopping|starting|restarting|reloading) / && !/the following/ {
    if      (/^stopping/)   add_unit("stopped",   $2)
    else if (/^starting/)   add_unit("started",   $2)
    else if (/^restarting/) add_unit("restarted", $2)
    else if (/^reloading/)  add_unit("reloaded",  $2)
    next
  }
  # Multi-unit action lines
  /^(stopping|starting|restarting|reloading) the following .*units?: / ||
  /^the following new units were started: / {
    finals()
    n_u = split(substr($0, index($0, ": ") + 2), us, ", ")
    if      (/^stopping/)          for (i=1; i<=n_u; i++) add_unit("stopped",   us[i])
    else if (/^starting/)          for (i=1; i<=n_u; i++) add_unit("started",   us[i])
    else if (/^restarting/)        for (i=1; i<=n_u; i++) add_unit("restarted", us[i])
    else if (/^reloading/)         for (i=1; i<=n_u; i++) add_unit("reloaded",  us[i])
    else if (/^the following new/) for (i=1; i<=n_u; i++) add_unit("new",       us[i])
    next
  }

  { if (active) finals(); say($0) }

  END {
    finals()
    printf "" > statef; close(statef)
    printf "fetched=%d\ndl_mib=%.1f\nbuilt=%d\nfailed_units=%d\n", fetched, dl_mib, built, n_failed > (cachedir "/last-run.stats")

    total = n_stopped + n_restarted + n_reloaded + n_started + n_new + n_failed
    if (total == 0) exit
    unitsf = cachedir "/last-units.txt"
    printf "" > unitsf
    list_group("Failed", failed_ord, n_failed)
    list_group("Stopped", stopped_ord, n_stopped)
    list_group("Restarted", restarted_ord, n_restarted)
    list_group("Reloaded", reloaded_ord, n_reloaded)
    list_group("Started", started_ord, n_started)
    list_group("New", new_ord, n_new)

    line = ""; for (j = 0; j < 58; j++) line = line "─"
    printf "\n─── Units %s\n", substr(line, 1, 48)
    s = ""
    if (n_stopped)   s = s n_stopped " stopped · "
    if (n_restarted) s = s n_restarted " restarted · "
    if (n_reloaded)  s = s n_reloaded " reloaded · "
    if (n_started)   s = s n_started " started · "
    if (n_new)       s = s n_new " new · "
    printf "  %s%d failed\n", s, n_failed
    for (i = 1; i <= n_failed; i++) printf "  ✗ %s failed\n", failed_ord[i]
    printf "%s\n", line
  }
  '
}

# ---------------------------------------------------------------------------
# _nru_fail_summary — turns a failed rebuild log into a short explanation.
#
# Sets _NRU_FAIL_KIND (hash | hash-stale | hash-manual | build | config |
# download | disk | unknown) and, for hash kinds, _NRU_FIX_PKG/_ATTR/_HASH,
# which _nru_rebuild uses to pick sensible menu options.
# ---------------------------------------------------------------------------
_nru_fail_summary() {
  local log=$1 drv spec got dep pkg="" attr="" msg loc nixlog
  _NRU_FAIL_KIND=unknown; _NRU_FIX_PKG=""; _NRU_FIX_ATTR=""; _NRU_FIX_HASH=""
  echo ""

  if grep -q 'hash mismatch in fixed-output derivation' "$log"; then
    drv=$(grep -m1 -oP "fixed-output derivation '/nix/store/[a-z0-9]{32}-\K[^']+(?=\.drv')" "$log")
    spec=$(grep -m1 -oP 'specified:\s+\Ksha256-\S+' "$log")
    got=$(grep -m1 -oP 'got:\s+\Ksha256-\S+' "$log")
    dep=$(( $(grep -c 'error: Cannot build' "$log") - 1 ))
    case $drv in
      *-pnpm-deps)           attr=pnpmDeps;  pkg=${drv%-pnpm-deps} ;;
      *-npm-deps)            attr=npmDeps;   pkg=${drv%-npm-deps} ;;
      *-cargo-deps|*-vendor) attr=cargoDeps; pkg=${${drv%-cargo-deps}%-vendor} ;;
      *-go-modules)          attr=goModules; pkg=${drv%-go-modules} ;;
    esac
    pkg=${pkg%%-[0-9]*}   # "foo-1.2.3" → "foo"
    _NRU_FIX_PKG=$pkg; _NRU_FIX_ATTR=$attr; _NRU_FIX_HASH=$got

    if [[ -n $pkg ]] && grep -qF "$spec" "$NIXOS_CONFIG/pkgs/hash-fixes/default.nix" 2>/dev/null; then
      _NRU_FAIL_KIND=hash-stale
      printf "  ✗  %s · our hash fix is now stale (nixpkgs fixed it upstream)\n" "$pkg"
    else
      # Only offer [F]ix when the attribute really exists and carries the
      # hash nix complained about — otherwise the override would miss.
      if [[ -n $attr ]] && [[ "$(nix eval --raw "$NIXOS_CONFIG#nixosConfigurations.$(hostname).pkgs.$pkg.$attr.outputHash" 2>/dev/null)" == "$spec" ]]; then
        _NRU_FAIL_KIND=hash
      else
        _NRU_FAIL_KIND=hash-manual
      fi
      printf "  ✗  %s · dependency hash mismatch (nixpkgs bug, not your config)\n" "${pkg:-$drv}"
      printf "       got %s\n" "$got"
      if [[ $_NRU_FAIL_KIND == hash ]]; then
        printf "       fix: [F] adds an override to pkgs/hash-fixes/default.nix\n"
      else
        printf "       fix: override the package's outputHash in an overlay\n"
      fi
    fi
    (( dep > 0 )) && printf "       + %d packages that depend on it also failed\n" "$dep"

  elif grep -q 'No space left on device' "$log"; then
    _NRU_FAIL_KIND=disk
    printf "  ✗  disk full · /nix has %s free · GC frees old generations\n" "$(df -h --output=avail /nix | tail -1 | tr -d ' ')"

  elif grep -qE 'unable to download|Could not resolve host|Couldn.t resolve host|Connection timed out|Failed to connect' "$log"; then
    _NRU_FAIL_KIND=download
    printf "  ✗  download failed · %s\n" "$(grep -m1 -oE "unable to download '[^']+'|Could(n.t| not) resolve host[^;]*" "$log")"
    printf "       retry usually fixes this\n"

  elif drv=$(grep -m1 -oP "builder for '/nix/store/[a-z0-9]{32}-\K[^']+(?=\.drv')" "$log"); then
    _NRU_FAIL_KIND=build
    nixlog=$(grep -m1 -oP "nix log \K/nix/store/\S+\.drv" "$log")
    printf "  ✗  build failed · %s\n" "$drv"
    grep -E '^\s+> ' "$log" | tail -5 | sed 's/^\s*>/       │/'
    [[ -n $nixlog ]] && printf "       full log: nix log %s\n" "$nixlog"

  elif ! grep -q 'error: Cannot build' "$log" && grep -qE '^\s*error:' "$log"; then
    _NRU_FAIL_KIND=config
    msg=$(grep -E '^\s*error: \S' "$log" | tail -1 | sed -E 's/^\s*error: //; s/ Definition values:$//')
    loc=$(grep -oP "(at |In \`)/nix/store/[a-z0-9]{32}-source/\K[^:']+(:\d+)?" "$log" | tail -1)
    printf "  ✗  config error · %s\n" "$msg"
    [[ -n $loc ]] && printf "       at %s\n" "$loc"

  else
    printf "  ✗  rebuild failed\n"
    grep -E '^\s*error:' "$log" | grep -vE 'Cannot build|Build failed due to failed dependency' \
      | head -5 | sed -E 's/^\s*/       /'
  fi

  printf "  full output: %s\n" "${log/#$HOME/~}"
}

# ---------------------------------------------------------------------------
# _nru_hash_fix — adds (kind hash) or removes (kind hash-stale) the entry for
# _NRU_FIX_PKG in pkgs/hash-fixes/default.nix. One entry per line, file ends "}".
# ---------------------------------------------------------------------------
_nru_hash_fix() {
  local f="$NIXOS_CONFIG/pkgs/hash-fixes/default.nix"
  sed -i "/^  ${_NRU_FIX_PKG} = /d" "$f"
  if [[ $_NRU_FAIL_KIND == hash ]]; then
    sed -i "\$i\\  ${_NRU_FIX_PKG} = { attr = \"${_NRU_FIX_ATTR}\"; hash = \"${_NRU_FIX_HASH}\"; added = \"$(date +%F)\"; };" "$f"
    printf "  ✎  added %s → pkgs/hash-fixes/default.nix · rebuilding…\n\n" "$_NRU_FIX_PKG"
  else
    printf "  ✎  removed %s from pkgs/hash-fixes/default.nix · rebuilding…\n\n" "$_NRU_FIX_PKG"
  fi
}

# ---------------------------------------------------------------------------
# _nixos_run — core rebuild helper used by nr / nru / nrt
#
# - Shows a build header with hostname (unless called from nru)
# - Holds a systemd sleep/idle inhibit lock for the full build duration
# - Tees all output to a temp log, pipes it through _nix_fetch_filter
# - On success: package diff via nvd; on failure: short summary + saved log
# - Calls nixos-log-rebuild to write warnings and an entry to the vault
#
# Leaves for callers: _NIXOS_LAST_GEN, _NIXOS_SWITCH_TIME, _NIXOS_CHANGED,
# and _NRU_FAIL_KIND (on failure).
# ---------------------------------------------------------------------------
_nixos_run() {
  local tmplog exit_code old_system new_system statef ok=0
  mkdir -p "$_NRU_CACHE"
  tmplog=$(mktemp /tmp/nixos-rebuild-XXXXXX.log)
  statef="$_NRU_CACHE/.ticker.$$"
  old_system=$(readlink -f /run/current-system 2>/dev/null)

  if [[ -z "$_NRU_NO_HEADER" ]]; then
    echo ""
    echo "══════════════════════════════════════════════════════════"
    printf "  ↻  Rebuild  ·  %s\n" "$(hostname)"
    echo "══════════════════════════════════════════════════════════"
    echo ""
  fi

  # One background ticker draws all live progress (see _nru_ticker);
  # &| starts it disowned so zsh never prints job notifications.
  print eval > "$statef"
  _nru_ticker "$statef" &|
  _NRU_TICKER_PID=$!

  # systemd-inhibit keeps the machine awake mid-build; the lock releases when
  # the command exits. The log (tee) captures raw output before the filter.
  # { } always { } is zsh's "finally" — the ticker is stopped even on errors.
  {
    systemd-inhibit --what=sleep:idle --who=nixos-rebuild \
      --why="NixOS rebuild in progress" \
      "$@" 2>&1 | tee "$tmplog" | _nix_fetch_filter "$statef" "$_NRU_CACHE"
    exit_code=$pipestatus[1]
  } always {
    kill "$_NRU_TICKER_PID" 2>/dev/null
    printf "\r\033[K" > /dev/tty
  }

  # Exit 4 = switch done but some units failed to start — still a success.
  (( exit_code == 0 || exit_code == 4 )) && ok=1
  new_system=$(readlink -f /run/current-system 2>/dev/null)
  _NIXOS_CHANGED=0
  [[ -n "$old_system" && "$old_system" != "$new_system" ]] && _NIXOS_CHANGED=1

  # Package diff — only when the system actually changed.
  if (( ok && _NIXOS_CHANGED )) && command -v nvd &>/dev/null; then
    local fmt_output
    fmt_output=$(nvd diff "$old_system" "$new_system" | _fmt_nvd)
    if [[ -n "$fmt_output" ]]; then
      printf '%s\n' "$fmt_output"
      printf '%s\n' "$fmt_output" > "$_NRU_CACHE/last-packages.txt"
    fi
  fi

  # Warnings + update log to the vault (never fails the shell). The
  # generation number goes to _NIXOS_LAST_GEN; the rest of the output is the
  # "─── Flagged ───" block, printed so it's visible at rebuild time.
  _NIXOS_LAST_GEN=""
  if command -v nixos-log-rebuild &>/dev/null; then
    local outcome="success" log_out
    (( ok )) || outcome="failure"
    log_out=$(nixos-log-rebuild --outcome "$outcome" --log "$tmplog" 2>&1) || true
    _NIXOS_LAST_GEN=$(printf '%s' "$log_out" | grep -oE 'gen [0-9]+' | grep -oE '[0-9]+' | head -1)
    [[ -n "$log_out" ]] && printf '%s\n' "$log_out" | grep -v '^nixos-log-rebuild:'
  fi

  # Switch duration from systemd's "Consumed … over 1.924s wall clock time"
  # line (hidden by _nix_fetch_filter).
  _NIXOS_SWITCH_TIME=""
  local _wall
  _wall=$(grep -oE 'over [0-9.]+(min|ms|s)( [0-9.]+s)? wall clock' "$tmplog" | tail -1)
  _wall=${${_wall#over }% wall clock}
  case $_wall in
    *min*) _NIXOS_SWITCH_TIME=$(printf '%dm %.0fs' ${_wall%%min*} ${${_wall##* }%s}) ;;
    *ms)   _NIXOS_SWITCH_TIME=$(printf '%.1fs' $(( ${_wall%ms} / 1000.0 ))) ;;
    *s)    _NIXOS_SWITCH_TIME=$(printf '%.1fs' ${_wall%s}) ;;
  esac

  if (( ! ok )); then
    cp "$tmplog" "$_NRU_CACHE/last-failure.log"
    _nru_fail_summary "$_NRU_CACHE/last-failure.log"
  fi

  rm -f "$tmplog" "$statef"
  return $exit_code
}

# Rebuild and switch to the current flake config.
nr() {
  _nixos_run sudo nixos-rebuild switch -L --no-link --flake "$NIXOS_CONFIG#$(hostname)"
}

# Test rebuild — activates now without touching the boot entry (safe for risky changes).
nrt() {
  _nixos_run sudo nixos-rebuild test -L --no-link --flake "$NIXOS_CONFIG#$(hostname)"
}

# ---------------------------------------------------------------------------
# _nru_rebuild — runs the rebuild; on failure offers only the options that
# can fix that kind of failure (Enter = the first, most likely fix). After a
# success: verdict, push (lock writer only), run summary, disk + reboot checks.
# Kept separate from nru so retries skip the git pull / input updates.
# ---------------------------------------------------------------------------
_nru_rebuild() {
  local cfg=$NIXOS_CONFIG code choice moved key
  local -a keys opts
  _NRU_ON_PREV=""

  while true; do
    _nixos_run sudo nixos-rebuild switch -L --no-link --flake "$cfg#$(hostname)"
    code=$?
    (( code == 0 || code == 4 )) && break
    (( code == 130 )) && _NRU_FAIL_KIND=interrupted

    # [p]revious lock only makes sense if this run changed the inputs.
    moved=""
    git -C "$cfg" diff --quiet HEAD -- flake.lock modules/gaming/default.nix pkgs/craft-apps/package.nix 2>/dev/null || moved=p
    case $_NRU_FAIL_KIND in
      hash)        keys=(f $moved l q) ;;
      hash-stale)  keys=(f l q) ;;
      hash-manual) keys=($moved l q) ;;
      build)       keys=($moved r l q) ;;
      config)      keys=($moved r l q) ;;
      download)    keys=(r q) ;;
      disk)        keys=(g q) ;;
      interrupted) keys=(r q) ;;
      *)           keys=(r $moved l q) ;;
    esac
    opts=()
    for key in $keys; do
      case $key in
        f) [[ $_NRU_FAIL_KIND == hash-stale ]] && opts+=("f:fix (remove override)") || opts+=("f:fix hash") ;;
        p) opts+=("p:previous lock") ;;
        r) opts+=("r:retry") ;;
        l) opts+=("l:log") ;;
        g) opts+=("g:GC + retry") ;;
        q) opts+=("q:quit") ;;
      esac
    done
    opts[1]="${(U)opts[1][1]}:${(C)opts[1][3]}${opts[1][4,-1]}"   # first option = default

    while true; do
      choice=$(_nru_menu "✗" "Rebuild Failed" "${opts[@]}")
      [[ $choice == l ]] || break
      less -R "$_NRU_CACHE/last-failure.log" </dev/tty >/dev/tty
    done

    case $choice in
      f) _nru_hash_fix ;;
      p) git -C "$cfg" restore flake.lock modules/gaming/default.nix pkgs/craft-apps/package.nix 2>/dev/null
         _NRU_ON_PREV=1
         printf "  ↺  restored flake.lock (nixpkgs %s) · rebuilding…\n\n" \
           "$(date -d @"$(jq -r '.nodes[.nodes.root.inputs.nixpkgs].locked.lastModified' "$cfg/flake.lock")" +%F)" ;;
      g) sudo nix-collect-garbage --delete-older-than 30d ;;
      r) ;;
      q) return 1 ;;
    esac
  done

  # ── Verdict ────────────────────────────────────────────────────────────────
  local -A st
  local kv
  for kv in ${(f)"$(<"$_NRU_CACHE/last-run.stats")"}; do st[${kv%%=*}]=${kv#*=}; done 2>/dev/null
  local -a info
  [[ -n $_NIXOS_LAST_GEN ]]    && info+=("generation $_NIXOS_LAST_GEN")
  [[ -n $_NIXOS_SWITCH_TIME ]] && info+=("switched in $_NIXOS_SWITCH_TIME")
  local extra="${info:+  (${(j: · :)info})}${_NRU_ON_PREV:+  · on previous lock}"
  echo ""
  if (( ! _NIXOS_CHANGED )); then
    printf "  ✓  No changes · still on generation %s\n" "${_NIXOS_LAST_GEN:-?}"
  elif (( code == 4 )); then
    printf "  ⚠  Rebuild done with %s unit failure%s%s\n" "${st[failed_units]:-?}" \
      "${${st[failed_units]:#1}:+s}" "$extra"
  else
    printf "  ✓  Rebuild successful%s\n" "$extra"
  fi

  # The scheduled auto-update skips its 3am run if nru ran within 20h, and the
  # session-start auto-update must not fire again right after nru.
  date +%s > /etc/nixos-last-update-time 2>/dev/null || true
  touch /run/user/$UID/nixos-update-done 2>/dev/null || true

  # ── Push shared state (lock writer only) ───────────────────────────────────
  # Git output is hidden on success, shown in full on failure.
  if _nru_is_lock_writer; then
    local git_out f
    local -a changed names
    changed=(${(f)"$(git -C "$cfg" status --porcelain -- flake.lock modules/gaming/default.nix pkgs/hash-fixes/default.nix pkgs/craft-apps/package.nix | cut -c4-)"})
    if (( $#changed )); then
      for f in $changed; do
        case $f in modules/gaming/default.nix) names+=("gaming module") ;; pkgs/craft-apps/package.nix) names+=("craft apps") ;; *) names+=("${f:t}") ;; esac
      done
      git -C "$cfg" add -- $changed
      # Commit only these paths — anything else the user has staged stays staged
      if ! git_out=$(git -C "$cfg" commit -m "flake: update inputs ($(date +%Y-%m-%d))" -- $changed 2>&1); then
        printf '%s\n' "$git_out"
      fi
      if git_out=$(git -C "$cfg" push 2>&1); then
        printf "  →  pushed %s to %s  (%s)\n" "$(git -C "$cfg" rev-parse --short HEAD)" \
          "$(git -C "$cfg" branch --show-current)" "${(j:, :)names}"
      else
        printf '%s\n' "$git_out"
        echo "  ✗  push failed — committed locally, push manually"
      fi
    fi
  fi

  # ── Run summary ────────────────────────────────────────────────────────────
  if [[ -n $_NRU_START ]]; then
    local t=$(( EPOCHSECONDS - _NRU_START )) dl=${st[dl_mib]:-0}
    if (( dl == 0 ));      then dl="nothing downloaded"
    elif (( dl >= 1024 )); then dl=$(printf '%.1f GiB downloaded' $(( dl / 1024.0 )))
    else                        dl=$(printf '%.0f MiB downloaded' $dl); fi
    printf "  ⏱  %dm %02ds total · %s · %s built\n" $(( t / 60 )) $(( t % 60 )) "$dl" "${st[built]:-0}"
  fi

  # ── Disk check ─────────────────────────────────────────────────────────────
  local pcent avail
  read -r pcent avail <<< "$(df -h --output=pcent,avail /nix | tail -1)"
  if (( ${pcent%\%} > 90 )); then
    [[ $(_nru_menu "⚠" "/nix ${pcent} full ($avail free)" "G:GC now" "s:skip") == g ]] \
      && sudo nix-collect-garbage --delete-older-than 30d
  fi

  # ── Firmware check ─────────────────────────────────────────────────────────
  # Uses the metadata fwupd-refresh.timer already fetched; exit 0 = updates
  # available, 2 = none. Notice only — installing is left to the user.
  fwupdmgr get-updates --no-unreported-check --no-metadata-check </dev/null &>/dev/null \
    && printf "  ⚠  Firmware update available · please run: fwupdmgr update\n"

  # ── Reboot check ───────────────────────────────────────────────────────────
  # Booted vs current system: a new kernel, initrd or systemd only fully takes
  # effect after a reboot.
  local -a why
  local b c
  if [[ "$(readlink -f /run/booted-system/kernel)" != "$(readlink -f /run/current-system/kernel)" ]]; then
    why+=("kernel $(uname -r) → $(ls /run/current-system/kernel-modules/lib/modules/ 2>/dev/null | head -1)")
  elif [[ "$(readlink -f /run/booted-system/initrd)" != "$(readlink -f /run/current-system/initrd)" ]]; then
    why+=("initrd")
  fi
  b=$(readlink -f /run/booted-system/systemd); c=$(readlink -f /run/current-system/systemd)
  [[ "$b" != "$c" ]] && why+=("systemd ${${b:t}#*-systemd-} → ${${c:t}#*-systemd-}")

  if (( $#why )); then
    curl -s -o /dev/null --max-time 10 \
      -H "Title: Reboot Required — $(hostname)" \
      -H "Priority: high" \
      -H "Tags: warning,arrows_counterclockwise" \
      -d "Reboot needed: ${(j:, :)why}. Reboot when convenient." \
      "http://media-server:2586/nixos-updates" 2>/dev/null || true
    [[ $(_nru_menu "⚠" "Reboot needed · ${(j:, :)why}" "R:reboot now" "l:later") == r ]] && sudo reboot
  else
    if (( code == 4 )); then
      [[ $(_nru_menu "⚠" "Rebuild done · close terminal?" "Y:yes" "n:no") == y ]] && exit 0
    else
      [[ $(_nru_menu "✓" "Rebuild Clean · close terminal?" "Y:yes" "n:no") == y ]] && exit 0
    fi
  fi
  return 0
}

# ---------------------------------------------------------------------------
# _nru_git_bar — pulls latest nixos-config (fast-forward only).
# Failures are named, and the fixable ones get a menu:
#   local changes → stash / discard / keep · diverged → rebase / keep
#   offline → rebuild the local config anyway (sets _NRU_OFFLINE)
# ---------------------------------------------------------------------------
_nru_git_bar() {
  local cfg=$NIXOS_CONFIG log="$_NRU_CACHE/git.log" before after n out
  _NRU_OFFLINE=""

  # nru regenerates flake.lock every run; a leftover local bump (or one staged
  # by a failed push) would block the pull. Say so when something is discarded.
  if ! git -C "$cfg" diff --quiet HEAD -- flake.lock 2>/dev/null; then
    printf "  \e[2m↺  discarded local flake.lock changes (nru regenerates it)\e[0m\n" >/dev/tty
    git -C "$cfg" restore --staged --worktree flake.lock 2>/dev/null
  fi

  before=$(git -C "$cfg" rev-parse --short HEAD)
  if _nru_spin "$_NRU_GH" "Nixos-Config" "pulling" "$log" git -C "$cfg" pull --ff-only; then
    after=$(git -C "$cfg" rev-parse --short HEAD)
    if [[ $before == "$after" ]]; then
      _nru_ok "$_NRU_GH" "Nixos-Config" "up to date"
    else
      n=$(git -C "$cfg" rev-list --count "$before..$after")
      _nru_ok "$_NRU_GH" "Nixos-Config" "$n commit${${n:#1}:+s}  $before → $after"
    fi
    return 0
  fi

  out=$(<"$log")
  case $out in
    *"would be overwritten by"*)
      _nru_git_local_changes; return ;;
    *"Not possible to fast-forward"*|*"diverging branches"*)
      _nru_git_diverged; return ;;
    *"Permission denied (publickey)"*|*"Host key verification failed"*)
      _nru_row "$_NRU_GH" "Nixos-Config" "✗ SSH auth failed · check your ~/.ssh key is added to GitHub"
      _nru_git_skip_or_quit; return ;;
    *"Could not resolve"*|*"Network is unreachable"*|*"Connection timed out"*|*"Connection refused"*|*"Temporary failure in name resolution"*)
      _nru_row "$_NRU_GH" "Nixos-Config" "⚠ offline"
      [[ $(_nru_menu "⚠" "Offline · rebuild local config anyway?" "Y:yes" "n:no") == y ]] || return 1
      _NRU_OFFLINE=1; echo ""; return 0 ;;
  esac

  _nru_row "$_NRU_GH" "Nixos-Config" "✗ pull failed"
  printf '%s\n' "$out"
  return 1
}

_nru_git_local_changes() {
  local cfg=$NIXOS_CONFIG f add del
  local -a files items
  # git lists the blocking files tab-indented under the "would be overwritten" line
  files=(${(f)"$(awk '/would be overwritten by/ {f=1; next} f && /^\t/ {sub(/^\t/, ""); print; next} {f=0}' "$_NRU_CACHE/git.log")"})
  for f in $files; do
    read -r add del _ <<< "$(git -C "$cfg" diff --numstat HEAD -- "$f")"
    items+=("$f${add:+   (+$add −$del)}")
  done
  _nru_row "$_NRU_GH" "Nixos-Config" "✗ local changes block the pull"
  _nru_tree "${items[@]}"

  case $(_nru_menu "⚠" "Local Changes" "S:Stash & pull" "d:discard & pull" "k:keep, skip pull" "q:quit") in
    s) git -C "$cfg" stash push -u -q -m "nru $(date '+%F %H:%M')" || return 1
       printf "  ↓  stashed as \"nru %s\" (git stash pop to restore)\n" "$(date '+%F %H:%M')"
       _nru_git_bar; return ;;
    d) for f in $files; do
         if git -C "$cfg" ls-files --error-unmatch -- "$f" &>/dev/null; then
           git -C "$cfg" checkout -q HEAD -- "$f"
         else
           rm -f -- "$cfg/$f"
         fi
       done
       _nru_git_bar; return ;;
    k) _nru_row "$_NRU_GH" "Nixos-Config" "⏭ kept local changes, skipped pull"; return 0 ;;
    q) return 1 ;;
  esac
}

_nru_git_diverged() {
  local cfg=$NIXOS_CONFIG ahead behind
  git -C "$cfg" fetch -q 2>/dev/null
  read -r ahead behind <<< "$(git -C "$cfg" rev-list --left-right --count 'HEAD...@{u}')"
  _nru_row "$_NRU_GH" "Nixos-Config" "✗ diverged · $ahead local / $behind remote commits"

  case $(_nru_menu "⚠" "Diverged" "R:Rebase local onto remote" "k:keep, skip pull" "q:quit") in
    r) if _nru_spin "$_NRU_GH" "Nixos-Config" "rebasing" "$_NRU_CACHE/git.log" git -C "$cfg" pull --rebase; then
         _nru_ok "$_NRU_GH" "Nixos-Config" "rebased $ahead local onto $behind remote"
         return 0
       fi
       git -C "$cfg" rebase --abort 2>/dev/null
       _nru_row "$_NRU_GH" "Nixos-Config" "✗ rebase conflict · rebase aborted, repo unchanged"
       _nru_git_skip_or_quit; return ;;
    k) _nru_row "$_NRU_GH" "Nixos-Config" "⏭ skipped pull · rebuilding local config"; return 0 ;;
    q) return 1 ;;
  esac
}

_nru_git_skip_or_quit() {
  [[ $(_nru_menu "⚠" "Pull Failed" "k:keep, skip pull" "Q:quit") == k ]] || return 1
  _nru_row "$_NRU_GH" "Nixos-Config" "⏭ skipped pull · rebuilding local config"
}

# ---------------------------------------------------------------------------
# _nru_inputs_bar — updates every flake input; shows which ones moved.
# Dates/revs come from flake.lock itself (before vs after), never parsed from
# nix's output. A failed update keeps the current lock and carries on.
# ---------------------------------------------------------------------------
_nru_lock_inputs() {   # "<input> <rev> <lastModified>" per root input
  jq -r '.nodes as $n | $n.root.inputs | to_entries[]
         | ($n[.value].locked) as $l | "\(.key) \($l.rev // $l.narHash) \($l.lastModified)"' \
    "$NIXOS_CONFIG/flake.lock"
}

_nru_inputs_bar() {
  local name="Flake Inputs" log="$_NRU_CACHE/inputs.log" k r t m w=0 od
  local -A old_rev old_ts
  local -a moved rows

  while read -r k r t; do old_rev[$k]=$r; old_ts[$k]=$t; done < <(_nru_lock_inputs)

  # Only the lock writer updates inputs; every other host builds exactly the
  # lock it just pulled. Same versions everywhere, and no GitHub API calls
  # from them (60/hour per IP, shared by every machine behind the home IP —
  # Media-Server hit it on 2026-10-13 once nru updated all 11 inputs).
  if ! _nru_is_lock_writer; then
    _nru_ok "$_NRU_NIX" "$name" "nixpkgs $(date -d @${old_ts[nixpkgs]} +%m-%d) · lock from Ryzen5900x"
    return 0
  fi
  if [[ -n $_NRU_OFFLINE ]]; then _nru_row "$_NRU_NIX" "$name" "⏭ skipped (offline)"; return 0; fi

  if ! _nru_spin "$_NRU_NIX" "$name" "updating ${#old_rev} inputs" "$log" nix flake update --flake "$NIXOS_CONFIG"; then
    git -C "$NIXOS_CONFIG" restore flake.lock 2>/dev/null
    if grep -q 'rate limit exceeded' "$log"; then
      _nru_row "$_NRU_NIX" "$name" "⚠ GitHub rate limit · keeping current lock (nixpkgs $(date -d @${old_ts[nixpkgs]} +%F))"
    else
      # nix's first "error:" line is often bare; the real message is the last one
      _nru_row "$_NRU_NIX" "$name" "⚠ update failed · keeping current lock (nixpkgs $(date -d @${old_ts[nixpkgs]} +%F))"
      grep -E '^\s*error: \S' "$log" | tail -1 | sed -E 's/^\s*/       /'
    fi
    return 0
  fi

  while read -r k r t; do
    [[ ${old_rev[$k]} == "$r" ]] && continue
    moved+=("$k|${old_ts[$k]}|$t")
    (( ${#k} > w )) && w=${#k}
  done < <(_nru_lock_inputs)

  if (( ! $#moved )); then _nru_ok "$_NRU_NIX" "$name" "up to date"; return 0; fi
  for m in $moved; do
    IFS='|' read -r k od t <<< "$m"
    # Same day on both sides says nothing — show the times instead.
    if [[ -z $od ]]; then od=new; t=$(date -d @$t +%m-%d)
    elif [[ $(date -d @$od +%F) == $(date -d @$t +%F) ]]; then od=$(date -d @$od +%H:%M); t=$(date -d @$t +%H:%M)
    else od=$(date -d @$od +%m-%d); t=$(date -d @$t +%m-%d); fi
    rows+=("$(printf "%-${w}s  %s → %s" "$k" "$od" "$t")")
  done
  _nru_ok "$_NRU_NIX" "$name" "$#moved of ${#old_rev} updated"
  _nru_tree "${rows[@]}"
}

# ---------------------------------------------------------------------------
# _nru_update_craft_apps — checks the storytold Craft apps for new releases.
# Tags come from git ls-remote (no GitHub API rate limit). Only the lock
# writer bumps pkgs/craft-apps/package.nix (version + hash from upstream's
# SHA256SUMS.txt, always written together); other hosts report and pull it.
# ---------------------------------------------------------------------------
_nru_craft_latest() {   # "<app> <version>" per app, all in parallel
  local a
  for a; do
    { print -r -- "$a ${$(GIT_TERMINAL_PROMPT=0 timeout 15 git ls-remote --tags --refs \
        "https://github.com/storytold/$a" 2>/dev/null | grep -oE 'v[0-9]+(\.[0-9]+)*$' | sort -V | tail -1)#v}" } &
  done
  wait
}
_nru_craft_sums() {     # "<app> <version> <sha256 hex>" per app@version, all in parallel
  local av
  for av; do
    { print -r -- "${av% *} ${av#* } $(curl -fsSL --max-time 15 \
        "https://github.com/storytold/${av% *}/releases/download/v${av#* }/SHA256SUMS.txt" 2>/dev/null \
        | grep -F "${av% *}-${av#* }-linux-x86_64.tar.gz" | cut -d' ' -f1)" } &
  done
  wait
}
_nru_update_craft_apps() {
  local pkg="$NIXOS_CONFIG/pkgs/craft-apps/package.nix" name="Craft Apps" icon=$_NRU_GH
  local log="$_NRU_CACHE/craft.log" a v h sri w=0
  local -A cur new
  local -a moved rows

  for a v in $(sed -nE 's/^\s+([a-z]+craft)\s+= \{ version = "([^"]+)".*/\1 \2/p' "$pkg"); do cur[$a]=$v; done
  (( $#cur )) || return 0
  if [[ -n $_NRU_OFFLINE ]]; then _nru_row "$icon" "$name" "⏭ skipped (offline)"; return 0; fi

  _nru_spin "$icon" "$name" "checking $#cur apps" "$log" _nru_craft_latest ${(k)cur}
  for a v in $(<"$log"); do new[$a]=$v; done
  if (( ! ${#${(M)${(v)new}:#?*}} )); then
    _nru_row "$icon" "$name" "⚠ GitHub unreachable · keeping current versions"; return 0
  fi
  for a in ${(ok)cur}; do
    [[ -n ${new[$a]} && ${new[$a]} != ${cur[$a]} ]] || continue
    [[ $(print -l ${cur[$a]} ${new[$a]} | sort -V | tail -1) == ${new[$a]} ]] || continue   # never downgrade
    moved+=($a); (( ${#a} > w )) && w=${#a}
  done

  if (( ! $#moved )); then _nru_ok "$icon" "$name" "all $#cur current"; return 0; fi
  if ! _nru_is_lock_writer; then
    _nru_ok "$icon" "$name" "$(( $#cur - $#moved )) of $#cur current" "· $#moved available (Ryzen5900x will bump them)"
    return 0
  fi

  # Version and hash are written together, only once the hash is known.
  local -a pairs; for a in $moved; do pairs+=("$a ${new[$a]}"); done
  _nru_spin "$icon" "$name" "hashing $#moved apps" "$log" _nru_craft_sums $pairs
  local -i n=0
  for a in $moved; do
    h=$(awk -v a=$a -v v=${new[$a]} '$1 == a && $2 == v { print $3 }' "$log")
    sri=${h:+$(nix hash convert --hash-algo sha256 --to sri "$h" 2>/dev/null)}
    if [[ -z $sri ]]; then
      rows+=("$(printf "⚠ %-${w}s  checksum unavailable · keeping %s" "$a" "${cur[$a]}")"); continue
    fi
    sed -i -E "s|^(\s+$a\s+= \{ version = \")[^\"]+(\"; hash = \")[^\"]+|\1${new[$a]}\2$sri|" "$pkg"
    rows+=("$(printf "%-${w}s  %s → %s" "$a" "${cur[$a]}" "${new[$a]}")"); (( n++ ))
  done
  _nru_ok "$icon" "$name" "$n of $#cur updated"
  _nru_tree "${rows[@]}"
}

# _nru_craft_unpackaged — reports storytold *craft repos missing from
# package.nix (a new app needs a suite + a build check, so never auto-added).
# Lock writer only: one GitHub API call, shared 60/h budget. Silent on failure.
_nru_craft_unpackaged() {
  _nru_is_lock_writer && [[ -z $_NRU_OFFLINE ]] || return 0
  local -a have new
  have=($(sed -nE 's/^\s+([a-z]+craft)\s+= \{.*/\1/p' "$NIXOS_CONFIG/pkgs/craft-apps/package.nix"))
  # artcraft = the engine itself, not a Craft app
  new=($(curl -fsSL --max-time 15 "https://api.github.com/orgs/storytold/repos?per_page=100" 2>/dev/null \
    | jq -r '.[] | select(.archived | not) | .name | select(test("^[a-z]+craft$") and . != "artcraft")' 2>/dev/null))
  new=(${new:|have})
  (( $#new )) || return 0
  _nru_row "$_NRU_GH" "Craft (new)" "🆕 ${(j:, :)new} · not packaged — add to pkgs/craft-apps/package.nix"
}

# _nru_update_proton_cachyos — checks GitHub for a new Proton-CachyOS release.
# Only the lock writer bumps the inline fetchzip in modules/gaming/default.nix
# (committed with flake.lock); other hosts just report it and get it on pull.
# nixpkgs has no CachyOS-Proton package under any name (checked), so this
# tracker stays; GE-Proton comes from nixpkgs (pkgs.proton-ge-bin).
# ---------------------------------------------------------------------------
_nru_update_proton_cachyos() {
  local gm="$NIXOS_CONFIG/modules/gaming/default.nix" name="Proton-Cachy" icon=$_NRU_GH
  local current latest cur_s new_s url tmp size total got xf pid hash i=1

  current=$(grep -oP 'protonCachyosTag = "\K[^"]+' "$gm")
  cur_s=${${current#cachyos-*-}%-slr}   # cachyos-11.0-20261005-slr → 20261005
  if [[ -n $_NRU_OFFLINE ]]; then _nru_row "$icon" "$name" "⏭ skipped (offline)"; return 0; fi

  # Pipe status is jq's, not curl's — offline or rate-limited curl hands jq
  # empty input and jq still exits 0, so test the result, not the exit code.
  latest=$(curl -fsSL --max-time 15 "https://api.github.com/repos/CachyOS/proton-cachyos/releases/latest" 2>/dev/null \
    | jq -r '.tag_name // empty' 2>/dev/null)
  if [[ -z $latest ]]; then _nru_row "$icon" "$name" "⚠ GitHub unreachable · keeping $cur_s"; return 0; fi
  new_s=${${latest#cachyos-*-}%-slr}

  if [[ $latest == "$current" ]]; then _nru_ok "$icon" "$name" "$cur_s"; return 0; fi
  if ! _nru_is_lock_writer; then
    _nru_ok "$icon" "$name" "$cur_s" "· $new_s available (Ryzen5900x will bump it)"; return 0
  fi

  # Download with real progress, then hash the local file.
  url="https://github.com/CachyOS/proton-cachyos/releases/download/${latest}/proton-${latest}-x86_64.tar.xz"
  tmp="$_NRU_CACHE/proton-${latest}.tar.xz"; xf="$_NRU_CACHE/.exit.$$"
  size=$(curl -fsSIL --max-time 15 "$url" 2>/dev/null | grep -i '^content-length:' | tail -1 | tr -dc '0-9')
  total=${size:+$(( size / 1048576 ))}
  rm -f "$xf" "$tmp"
  { curl -fsSL -o "$tmp" "$url"; echo $? >"$xf" } &|
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    got=$(( $(stat -c %s "$tmp" 2>/dev/null || echo 0) / 1048576 ))
    printf "\r  %s  %-12s  ⬇ downloading %s · %d/%s MiB  %s\033[K" \
      "$icon" "$name" "$new_s" "$got" "${total:-?}" "$_NRU_SPIN[i]" >/dev/tty
    sleep 0.2
    i=$(( i % 10 + 1 ))
  done
  if (( $(_nru_wait_exit "$xf") == 0 )); then
    _nru_spin "$icon" "$name" "hashing $new_s" "$_NRU_CACHE/proton.log" \
      nix store prefetch-file --hash-type sha256 --unpack "file://$tmp"
    hash=$(grep -m1 -oP 'sha256-[A-Za-z0-9+/=]+' "$_NRU_CACHE/proton.log")
  fi
  rm -f "$tmp"
  if [[ -z $hash ]]; then
    _nru_row "$icon" "$name" "⚠ download failed · keeping $cur_s, module untouched"; return 0
  fi

  # Tag and hash are written together, only once the hash is known.
  sed -i \
    -e "s|protonCachyosTag = \"[^\"]*\"; # proton-cachyos-nru|protonCachyosTag = \"${latest}\"; # proton-cachyos-nru|" \
    -e "s|hash = \"sha256-[A-Za-z0-9+/=]*\"; # proton-cachyos-hash|hash = \"${hash}\"; # proton-cachyos-hash|" \
    "$gm"
  _nru_ok "$icon" "$name" "$cur_s → $new_s"
}

# ---------------------------------------------------------------------------
# _nru_flatpak_bar — updates Flatpak apps in user AND system scope through the
# shared nixos-flatpak-update script (modules/system/graphical/default.nix;
# the weekly timers use the same one). System scope runs via a passwordless
# sudo rule for exactly that command. Silent where Flathub is absent (Alex's
# machines, where the remote is deliberately removed for child safety).
# ---------------------------------------------------------------------------
_nru_flatpak_bar() {
  local icon=$_NRU_FP name="Flatpak" log="$_NRU_CACHE/flatpak.log" line scope kind app rest f
  local -a updated failed

  if ! command -v nixos-flatpak-update &>/dev/null; then
    _nru_row "$icon" "$name" "⏭ skipped (updater installs with this rebuild)"; return 0
  fi
  if [[ -n $_NRU_OFFLINE ]]; then _nru_row "$icon" "$name" "⏭ skipped (offline)"; return 0; fi

  _nru_spin "$icon" "$name" "updating" "$log" zsh -c \
    'nixos-flatpak-update --user; /run/wrappers/bin/sudo -n /run/current-system/sw/bin/nixos-flatpak-update --system'

  while IFS= read -r line; do
    if [[ $line == sudo:* ]]; then failed+=("system scope|$line"); continue; fi
    read -r scope kind app rest <<< "$line"
    case $kind in
      skipped) [[ $app == no-flathub ]] && { printf "\r\033[K" >/dev/tty; return 0 } ;;
      updated) updated+=("$rest  ($scope)") ;;
      failed)  [[ $app == - ]] && app="$scope scope"   # listing failed, no app
               failed+=("${app##*.}|$rest") ;;
    esac
  done < "$log"

  if (( $#failed )); then
    _nru_row "$icon" "$name" "✗ ${(j:, :)${failed%%|*}} failed${updated:+ · others updated}"
    for f in ${failed[1,3]}; do printf "       %s\n" "${f#*|}"; done
    (( $#updated )) && _nru_tree "${updated[@]}"
  elif (( $#updated )); then
    _nru_ok "$icon" "$name" "$#updated updated"
    _nru_tree "${updated[@]}"
  else
    _nru_ok "$icon" "$name" "up to date"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# nru — update everything, then rebuild.
# Pulls nixos-config, updates all flake inputs, Proton-CachyOS (gaming hosts)
# and Flatpaks (graphical hosts), rebuilds, then summarises. Failures at each
# step offer only the options that make sense for that failure.
# ---------------------------------------------------------------------------
nru() {
  _NRU_START=$EPOCHSECONDS
  mkdir -p "$_NRU_CACHE"

  # TRAPINT fires on Ctrl+C even in interactive zsh (unlike `always` blocks).
  # Stops the ticker and offers a retry. Self-removes so later Ctrl+C in the
  # shell behaves normally.
  TRAPINT() {
    unfunction TRAPINT 2>/dev/null
    kill "$_NRU_TICKER_PID" 2>/dev/null
    printf "\r\033[K\n" >/dev/tty
    if [[ $(_nru_menu "✗" "Rebuild Interrupted" "R:retry" "q:quit") == r ]]; then
      _NRU_NO_HEADER=1 _nru_rebuild
    fi
    return 130
  }

  echo ""
  echo "══════════════════════════════════════════════════════════"
  printf "  ↻  Update & Rebuild  ·  %s\n" "$(hostname)"
  echo "══════════════════════════════════════════════════════════"
  echo ""

  _nru_git_bar || { unfunction TRAPINT 2>/dev/null; return 1 }
  # New shells load HM's copy of this file (last rebuild), not the repo. Re-source
  # the repo copy silently so the remaining steps run the latest nru code
  # (functions resolve at call time; only this function's step list stays old).
  _NRU_QUIET=1 source "$NIXOS_CONFIG/dotfiles/zsh/zshrc"
  _nru_inputs_bar
  command -v steam   &>/dev/null && _nru_update_proton_cachyos
  command -v photocraft &>/dev/null && { _nru_update_craft_apps; _nru_craft_unpackaged }
  command -v flatpak &>/dev/null && _nru_flatpak_bar

  echo ""
  _NRU_NO_HEADER=1 _nru_rebuild
  local rc=$?
  unfunction TRAPINT 2>/dev/null
  return $rc
}

# NixOS aliases — available to all users on all hosts
alias nrr='sudo nixos-rebuild switch --rollback'
alias ngc='sudo nix-collect-garbage --delete-older-than 30d'
alias ngens='sudo nix-env --list-generations --profile /nix/var/nix/profiles/system'

# ---------------------------------------------------------------------------
# hytale — launch Hytale with gamepad sc-controller profile, restore after
#
# sc-controller's Desktop profile consumes all Steam Controller input as
# mouse/keyboard. Switching to "XBox Controller" before launch makes it
# emit real gamepad events that Hytale (Chromium gamepad API) can detect.
# The Desktop profile is restored when the game exits, whether cleanly or
# via Ctrl-C / kill.
# ---------------------------------------------------------------------------
hytale() {
  local SCC="scc"
  local PREV_PROFILE
  PREV_PROFILE=$($SCC info 2>/dev/null | grep -i 'profile:' | awk '{print $2}')
  [[ -z "$PREV_PROFILE" ]] && PREV_PROFILE="Desktop"

  $SCC set-profile "XBox Controller" 2>/dev/null
  trap '$SCC set-profile "$PREV_PROFILE" 2>/dev/null' EXIT INT TERM

  flatpak run com.hypixel.HytaleLauncher "$@"

  $SCC set-profile "$PREV_PROFILE" 2>/dev/null
  trap - EXIT INT TERM
}

# ---------------------------------------------------------------------------
# OpenCode — runs with OpenRouter API (key from agenix)
# ---------------------------------------------------------------------------
opencode() {
  ANTHROPIC_API_KEY="$(cat /run/agenix/openrouter-api-key 2>/dev/null)" \
  ANTHROPIC_BASE_URL="https://openrouter.ai/api" \
  command opencode "$@"
}

# ---------------------------------------------------------------------------
# ctrl-check — detect connected controllers and report their status
#
# Shows three layers that games (SDL2 / Hytale) depend on:
#   js*     — legacy joystick nodes (SDL fallback)
#   event*  — evdev nodes flagged as joystick/gamepad by udev
#   hidraw* — raw HID nodes used by sc-controller for the Steam Controller
#
# For each device: name, vendor:product ID, and whether the current user
# has access (uaccess tag or readable node). A ✓ means the game can see it;
# an ✗ means a udev rule is missing or the user isn't in the right group.
# ---------------------------------------------------------------------------
ctrl-check() {
  local bold='\e[1m' reset='\e[0m'
  local green='\e[32m' red='\e[31m' dim='\e[2m' cyan='\e[36m'

  _cc_access() {
    # Returns ✓ (green) if readable, ✗ (red) if not
    [[ -r "$1" ]] && echo "${green}✓${reset}" || echo "${red}✗${reset}"
  }

  _cc_udev_attr() {
    # Extract a udevadm property by key, e.g. ID_VENDOR_ID
    udevadm info --query=property --name="$1" 2>/dev/null \
      | grep "^${2}=" | cut -d= -f2-
  }

  echo ""
  printf "${bold}  Controller Check${reset}\n"
  printf "${dim}  ─────────────────────────────────────────────────${reset}\n"

  # ── 1. Joystick nodes (js*) ────────────────────────────────────────────
  printf "\n${cyan}${bold}  js nodes${reset}  ${dim}(legacy joystick API)${reset}\n"
  local found_js=0
  for dev in /dev/input/js*; do
    [[ -e "$dev" ]] || continue
    found_js=1
    local name vendor product
    name=$(udevadm info --query=property --name="$dev" 2>/dev/null \
           | grep '^ID_MODEL=' | cut -d= -f2-)
    vendor=$(_cc_udev_attr "$dev" ID_VENDOR_ID)
    product=$(_cc_udev_attr "$dev" ID_MODEL_ID)
    [[ -z "$name"    ]] && name="unknown"
    [[ -z "$vendor"  ]] && vendor="????"
    [[ -z "$product" ]] && product="????"
    printf "  $(_cc_access "$dev") ${bold}%-20s${reset}  ${dim}%s:%s${reset}  %s\n" \
      "$dev" "$vendor" "$product" "$name"
  done
  [[ $found_js -eq 0 ]] && printf "  ${dim}  none${reset}\n"

  # ── 2. Evdev gamepad nodes (event* with joystick/gamepad flag) ─────────
  printf "\n${cyan}${bold}  evdev nodes${reset}  ${dim}(SDL2 / game input layer)${reset}\n"
  local found_ev=0
  for dev in /dev/input/event*; do
    [[ -e "$dev" ]] || continue
    local props
    props=$(udevadm info --query=property --name="$dev" 2>/dev/null)
    echo "$props" | grep -qE '^ID_INPUT_(JOYSTICK|GAMEPAD|ACCELEROMETER)=1' || continue
    found_ev=1
    local name vendor product
    name=$(echo   "$props" | grep '^ID_MODEL='     | cut -d= -f2-)
    vendor=$(echo  "$props" | grep '^ID_VENDOR_ID=' | cut -d= -f2-)
    product=$(echo "$props" | grep '^ID_MODEL_ID='  | cut -d= -f2-)
    [[ -z "$name"    ]] && name="unknown"
    [[ -z "$vendor"  ]] && vendor="????"
    [[ -z "$product" ]] && product="????"
    printf "  $(_cc_access "$dev") ${bold}%-25s${reset}  ${dim}%s:%s${reset}  %s\n" \
      "$dev" "$vendor" "$product" "$name"
  done
  [[ $found_ev -eq 0 ]] && printf "  ${dim}  none${reset}\n"

  # ── 3. HID raw nodes (hidraw*) — sc-controller / Steam Controller ──────
  printf "\n${cyan}${bold}  hidraw nodes${reset}  ${dim}(sc-controller / HID mode)${reset}\n"
  local found_hid=0
  for dev in /dev/hidraw*; do
    [[ -e "$dev" ]] || continue
    found_hid=1
    local name vendor product
    name=$(udevadm info --query=property --name="$dev" 2>/dev/null \
           | grep '^HID_NAME=' | cut -d= -f2-)
    vendor=$(_cc_udev_attr "$dev" HID_ID)
    # HID_ID is "BUS:VENDOR:PRODUCT" — extract last two fields
    [[ -n "$vendor" ]] && product=$(echo "$vendor" | cut -d: -f3) \
                       && vendor=$(echo  "$vendor" | cut -d: -f2)
    [[ -z "$name"    ]] && name="unknown"
    [[ -z "$vendor"  ]] && vendor="????"
    [[ -z "$product" ]] && product="????"
    printf "  $(_cc_access "$dev") ${bold}%-20s${reset}  ${dim}%s:%s${reset}  %s\n" \
      "$dev" "$vendor" "$product" "$name"
  done
  [[ $found_hid -eq 0 ]] && printf "  ${dim}  none${reset}\n"

  printf "\n${dim}  ─────────────────────────────────────────────────${reset}\n"
  printf "  ${dim}✓ = readable by $USER   ✗ = missing udev rule or group${reset}\n\n"

  unfunction _cc_access _cc_udev_attr 2>/dev/null
}

