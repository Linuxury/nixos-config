#!/usr/bin/env bash
# Bump Media-Server's pinned Plex to the newest build on a channel.
#   scripts/plex-bump            # Plex Pass beta (default)
#   scripts/plex-bump public     # public release
# Beta needs your Plex token: $PLEX_TOKEN, ~/.config/plex-token, or the server's Preferences.xml.
# Rewrites hosts/Media-Server/plex.json only; commit and nru yourself.
set -euo pipefail
cd "$(dirname "$0")/.."
channel=${1:-plexpass}
out=hosts/Media-Server/plex.json
api=https://plex.tv/api/downloads/5.json?channel=$channel

hdr=()
if [ "$channel" = plexpass ]; then
  token=${PLEX_TOKEN:-}
  [ -n "$token" ] || { [ -r ~/.config/plex-token ] && token=$(tr -d '[:space:]' < ~/.config/plex-token) || true; }
  [ -n "$token" ] || token=$(grep -so 'PlexOnlineToken="[^"]*"' "/data/config/plex/Plex Media Server/Preferences.xml" | cut -d'"' -f2 || true)
  [ -n "$token" ] || { echo "no Plex token (set PLEX_TOKEN)" >&2; exit 1; }
  hdr=(-H "X-Plex-Token: $token")   # header, not URL, so it stays out of logs
fi

version=$(curl -fsS "${hdr[@]}" "$api" | jq -r '.computer.Linux.version')
[ -n "$version" ] && [ "$version" != null ] || { echo "no version from $channel" >&2; exit 1; }
if [ "$version" = "$(jq -r .version "$out")" ]; then echo "already on $version"; exit 0; fi

sha=$(nix-prefetch-url "https://downloads.plex.tv/plex-media-server-new/$version/debian/plexmediaserver_${version}_amd64.deb")
jq -n --arg v "$version" --arg s "$sha" '{version:$v, sha256:$s}' > "$out"
echo "pinned $version"
