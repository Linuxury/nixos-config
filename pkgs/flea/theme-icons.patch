+/// Theme icon names for a file row, most specific first: the MIME type's own icon (text-x-python), then the generic one the backend picked. A folder is just `folder`.
+pub(crate) fn theme_names(name: &str, dir: bool, generic: &str) -> Vec<String> {
+    if dir {
+        return vec!["folder".to_owned()];
+    }
+    static DB: std::sync::OnceLock<flea::backend::mime::Db> = std::sync::OnceLock::new();
+    let mut names = Vec::new();
+    if let Some(mime) = DB.get_or_init(flea::backend::mime::Db::load).lookup(name) {
+        names.push(mime.replace('/', "-"));
+    }
+    if !generic.is_empty() {
+        names.push(generic.to_owned());
+    }
+    names
+}
+
+/// Starts any raster work a row's theme icons still need; call it with the App before painting.
+pub(crate) fn request_theme(names: &[String], logical: f32, window: &Window, cx: &mut App) {
+    load_names(names, logical, window, cx);
+}
+
+/// Paints a row's first ready theme icon in `at`; false leaves the caller to paint its built-in mark.
+pub(crate) fn paint_theme(
+    names: &[String],
+    logical: f32,
+    at: Bounds<Pixels>,
+    window: &mut Window,
+    cx: &App,
+) -> bool {
+    names.iter().any(|name| {
+        held_at(name, logical, window, cx)
+            .is_some_and(|image| window.paint_image(at, at, Default::default(), image, 0, false).is_ok())
+    })
+}
+
+/// `load` for a caller that only holds the App, as a paint pass does; each name is requested once per size.
+fn load_names(names: &[String], logical: f32, window: &Window, cx: &mut App) {
+    let side = pixels(logical, window);
+    let (size, scale) = (
+        logical.round().max(1.) as u32,
+        window.scale_factor().ceil().max(1.) as u32,
+    );
+    for name in names {
+        match cx.default_global::<AppIcons>().held.entry((name.clone(), side)) {
+            Entry::Vacant(pending) => pending.insert(None),
+            Entry::Occupied(_) => continue,
+        };
+        let (name, renderer) = (name.clone(), cx.svg_renderer());
+        let work = cx.background_executor().spawn({
+            let name = name.clone();
+            async move {
+                let path = Icons::session().resolve(&name, size, scale)?;
+                Some(pv1::raster_run(&pv1::RasterJob {
+                    raster: pv1::raster_for_path(&path, renderer),
+                    path,
+                    size: (side, side),
+                    epoch: 0,
+                    latest: Arc::new(AtomicU64::new(0)),
+                }))
+            }
+        });
+        cx.spawn(async move |cx| {
+            let Some(pv1::RasterOutcome::Raster(image)) = work.await else {
+                return;
+            };
+            cx.update(|cx| {
+                cx.default_global::<AppIcons>()
+                    .held
+                    .insert((name, side), Some(image));
+                cx.refresh_windows();
+            });
+        })
+        .detach();
+    }
+}
